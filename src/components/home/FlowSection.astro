---
import { getLang } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";

const lang = getLang(Astro);
const c = homeCopy[lang].how;
const clients = ["Claude Code", "Codex", "Cursor", c.agents];
const models = ["OpenAI", "Anthropic", "Gemini", "Azure OpenAI", "AWS Bedrock", c.mcp];
---

<section id="how" class="container-page scroll-mt-20 py-20 lg:py-28">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-4">
      <div class="font-mono text-[13px] uppercase tracking-[0.08em] text-[var(--color-muted)]">{c.eyebrow}</div>
      <h2
        class:list={[
          "font-display text-white [text-wrap:balance]",
          lang === "zh-CN" ? "text-[30px] leading-[1.35] sm:text-[40px] lg:text-[48px]" : "text-[40px] leading-[1.05] sm:text-[56px] lg:text-[64px]",
        ]}
      >{c.title}</h2>
    </div>
    <div class="hidden shrink-0 gap-7 whitespace-nowrap text-sm text-[var(--color-muted)] md:flex">
      <span class="flex items-center gap-2"><span class="h-0.5 w-[18px] rounded bg-[var(--color-brand-1)]"></span>{c.allowed}</span>
      <span class="flex items-center gap-2"><span class="h-0.5 w-[18px] rounded bg-[var(--color-accent)]"></span>{c.held}</span>
    </div>
  </div>

  <div data-flow-stage class="flow-stage relative mt-12 hidden h-[420px] overflow-hidden rounded-[20px] border border-[var(--color-border)] md:block">
    <canvas data-flow-canvas class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="absolute bottom-0 left-7 top-0 flex flex-col justify-around py-10 text-[15px] text-[#cbd5e1]">
      {clients.map((name) => <span data-lane-in>{name}</span>)}
    </div>
    <div class="absolute bottom-0 right-7 top-0 flex flex-col items-end justify-around py-5 text-[15px] text-[#cbd5e1]">
      {models.map((name) => <span data-lane-out>{name}</span>)}
    </div>
    <div class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-3.5">
      <div class="flow-core flex h-[104px] w-[104px] items-center justify-center rounded-[26px] bg-[var(--color-navy)]">
        <svg width="72" height="72" viewBox="32 32 136 136" fill="none" aria-hidden="true"><rect x="32" y="32" width="136" height="136" rx="28" stroke="#3DDBD9" stroke-width="10"></rect><line x1="62" y1="68" x2="138" y2="68" stroke="#3DDBD9" stroke-width="12" stroke-linecap="round"></line><line x1="100" y1="68" x2="100" y2="104" stroke="#3DDBD9" stroke-width="12" stroke-linecap="round"></line><polyline points="62,104 80,140 100,104" stroke="#3DDBD9" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"></polyline><polyline points="100,104 120,140 138,104" stroke="#3DDBD9" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
      </div>
      <span class="rounded-full border border-[var(--color-border-strong)] bg-[rgba(11,18,32,0.85)] px-3 py-1.5 font-mono text-[13px] text-[#cbd5e1]">{c.core}</span>
    </div>
  </div>

  <div class="mt-10 flex flex-col md:hidden">
    <div class="flex flex-col gap-1.5 rounded-xl border border-[var(--color-border-strong)] p-[18px]">
      <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted)]">{c.clients}</div>
      <div class="text-[15px] text-[#cbd5e1]">{clients.join(" · ")}</div>
    </div>
    <div class="ml-7 h-7 w-px bg-[var(--color-brand-1)]"></div>
    <div class="flex flex-col gap-2 rounded-xl border border-[var(--color-brand-1)] bg-[var(--color-surface)] p-5">
      <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-brand-1)]">ThinkWatch</div>
      <div class="font-display text-[30px] leading-[1.1] text-white">{c.stackedCore}</div>
    </div>
    <div class="ml-7 h-7 w-px bg-[var(--color-brand-1)]"></div>
    <div class="flex flex-col gap-1.5 rounded-xl border border-[var(--color-border-strong)] p-[18px]">
      <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted)]">{c.models}</div>
      <div class="text-[15px] leading-normal text-[#cbd5e1]">{models.join(" · ")}</div>
    </div>
  </div>
</section>

<style>
  .flow-stage {
    background: radial-gradient(ellipse at 50% 50%, rgba(61, 219, 217, 0.07), transparent 60%), #0d1526;
  }
  .flow-core {
    box-shadow: 0 0 0 1px rgba(61, 219, 217, 0.5), 0 0 50px 4px rgba(61, 219, 217, 0.2);
    animation: flow-pulse 2.6s ease-in-out infinite;
  }
  @keyframes flow-pulse {
    0%, 100% { box-shadow: 0 0 0 1px rgba(61, 219, 217, 0.5), 0 0 50px 4px rgba(61, 219, 217, 0.2); }
    50% { box-shadow: 0 0 0 1px rgba(61, 219, 217, 0.8), 0 0 90px 14px rgba(61, 219, 217, 0.35); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-core { animation: none; }
  }
</style>

<script>
  // Particles flow from each client label into the gateway mark and fan out to
  // each model label. Amber particles stand for requests held at the gateway:
  // they stop at the centre and leave a ripple. Lanes are read from the label
  // positions, so the drawing follows the layout at any width.
  type Particle = { x: number; lin: number; lout: number; sp: number; jy: number; amber: boolean };

  function initFlow(stage: HTMLElement) {
    const canvas = stage.querySelector<HTMLCanvasElement>("[data-flow-canvas]");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let W = 0, H = 0, cx = 0, cy = 0, x0 = 0, x1 = 0;
    let inL: number[] = [];
    let outL: number[] = [];
    const particles: Particle[] = [];
    const rings: { r: number; a: number }[] = [];
    let raf = 0;
    let visible = false;
    let t = 0;

    const smooth = (v: number) => {
      const k = Math.max(0, Math.min(1, v));
      return k * k * (3 - 2 * k);
    };
    const yAt = (p: Particle, x: number) => {
      const lin = inL[p.lin] ?? cy;
      const lout = outL[p.lout] ?? cy;
      if (x < cx) {
        const e = smooth((x - x0) / (cx - x0));
        return lin + (cy - lin) * e + p.jy * (1 - e);
      }
      const e = smooth((x - cx) / (x1 - cx));
      return cy + (lout - cy) * e + p.jy * e;
    };
    const spawn = (p: Particle, anywhere: boolean) => {
      p.lin = Math.floor(Math.random() * Math.max(1, inL.length));
      p.lout = Math.floor(Math.random() * Math.max(1, outL.length));
      p.sp = 1.2 + Math.random() * 1.8;
      p.jy = (Math.random() - 0.5) * 16;
      p.amber = Math.random() < 0.07;
      p.x = anywhere ? x0 + Math.random() * (x1 - x0) : x0 - Math.random() * 40;
      if (p.amber && p.x > cx - 50) p.x = x0 + Math.random() * Math.max(1, cx - x0 - 60);
      return p;
    };

    const layout = () => {
      const box = stage.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = box.width;
      H = box.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = W / 2;
      cy = H / 2;
      const mid = (el: Element) => {
        const b = el.getBoundingClientRect();
        return b.top - box.top + b.height / 2;
      };
      const ins = Array.from(stage.querySelectorAll("[data-lane-in]"));
      const outs = Array.from(stage.querySelectorAll("[data-lane-out]"));
      inL = ins.map(mid);
      outL = outs.map(mid);
      x0 = Math.max(...ins.map((el) => el.getBoundingClientRect().right - box.left)) + 18;
      x1 = Math.min(...outs.map((el) => el.getBoundingClientRect().left - box.left)) - 18;
      if (particles.length === 0) {
        const count = Math.round(Math.min(420, Math.max(160, W * 0.3)));
        for (let i = 0; i < count; i++) particles.push(spawn({} as Particle, true));
      }
    };

    const frame = () => {
      t += 1;
      ctx.clearRect(0, 0, W, H);
      const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 150);
      g.addColorStop(0, `rgba(61,219,217,${0.16 + Math.sin(t / 40) * 0.05})`);
      g.addColorStop(1, "rgba(61,219,217,0)");
      ctx.fillStyle = g;
      ctx.fillRect(cx - 150, cy - 150, 300, 300);

      ctx.globalCompositeOperation = "lighter";
      ctx.lineCap = "round";
      for (const p of particles) {
        p.x += p.sp;
        if (p.amber && p.x >= cx - 58) {
          rings.push({ r: 56, a: 0.9 });
          spawn(p, false);
          continue;
        }
        if (p.x > x1) {
          spawn(p, false);
          continue;
        }
        if (p.x < x0) continue;
        const px = p.x - p.sp * 7;
        const edge = Math.min(1, (p.x - x0) / 60, (x1 - p.x) / 60);
        ctx.strokeStyle = p.amber ? `rgba(229,192,123,${0.95 * edge})` : `rgba(61,219,217,${0.75 * edge})`;
        ctx.lineWidth = p.amber ? 2.2 : 1.5;
        ctx.beginPath();
        ctx.moveTo(px, yAt(p, px));
        ctx.lineTo(p.x, yAt(p, p.x));
        ctx.stroke();
      }
      ctx.globalCompositeOperation = "source-over";
      for (let i = rings.length - 1; i >= 0; i--) {
        const r = rings[i];
        r.r += 1.1;
        r.a -= 0.018;
        if (r.a <= 0) {
          rings.splice(i, 1);
          continue;
        }
        ctx.strokeStyle = `rgba(229,192,123,${r.a})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(cx, cy, r.r, 0, Math.PI * 2);
        ctx.stroke();
      }
    };

    const loop = () => {
      frame();
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (reduced || raf || !visible) return;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    const drawStill = () => {
      for (let i = 0; i < 240; i++) frame();
    };

    layout();
    if (reduced) drawStill();

    new ResizeObserver(() => {
      if (stage.offsetParent === null) return;
      layout();
      if (reduced) drawStill();
    }).observe(stage);

    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
      if (visible) start();
      else stop();
    }).observe(stage);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-flow-stage]").forEach(initFlow);
</script>
