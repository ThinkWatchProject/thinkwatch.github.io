---
import { productName } from "~/content/docs/_meta";
// Documentation home (/docs, /zh-CN/docs): intro, one card per product listing
// its docs. It is also ThinkWatch's docs home, so the sidebar shows ThinkWatch.
import DocsLayout from "~/layouts/DocsLayout.astro";
import { docHref, products, productHomeHref } from "~/content/docs/_meta";
import { localePath, type Lang } from "~/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const zh = lang === "zh-CN";

const copy = zh
  ? {
      title: "文档 · ThinkWatch",
      description:
        "ThinkWatch、ThinkWatch Lite 与 ThinkWatch Core 的文档，涵盖架构、部署、配置、API 参考、安全模型、桌面应用与共享核心。",
      h1: "文档",
      intro:
        "三个产品分别提供文档：面向团队与企业的 ThinkWatch、在本地运行的桌面应用 ThinkWatch Lite，以及二者共用的 ThinkWatch Core。可通过上方的切换器选择产品，或从下方卡片进入。",
      open: (name: string) => `进入 ${name} 文档`,
      more: "其他资源",
    }
  : {
      title: "Documentation · ThinkWatch",
      description:
        "Documentation for ThinkWatch, ThinkWatch Lite, and ThinkWatch Core, covering architecture, deployment, configuration, API reference, the security model, the desktop application, and the shared core.",
      h1: "Documentation",
      intro:
        "Documentation is provided for three products: ThinkWatch, for teams and enterprises; ThinkWatch Lite, a desktop application that runs locally; and ThinkWatch Core, the crates both are built on. Select a product with the switcher above or from the cards below.",
      open: (name: string) => `Open ${name} docs`,
      more: "Additional resources",
    };
---

<DocsLayout title={copy.title} description={copy.description} product="thinkwatch" current="">
  <h1>{copy.h1}</h1>
  <p>{copy.intro}</p>

  <!-- Outside .prose-tw (see DocsLayout): cards, then a prose block of links. -->
  <div slot="after">
  <div class="mt-10 grid gap-4">
    {products.map((p) => {
      const docs = p.docs.filter((d) => d.slug);
      return (
        <section class="rounded-xl border border-[var(--color-border-strong)] bg-[var(--color-surface)]/60 p-5 sm:p-6">
          <h2 class="text-lg font-semibold tracking-tight text-[var(--color-text)]">
            <a href={productHomeHref(lang, p.id)} class="hover:text-[var(--color-brand-1)] transition-colors">{productName(p, lang)}</a>
          </h2>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-muted)]">{p.tagline[lang]}</p>
          <ul class="mt-4 grid gap-x-4 sm:grid-cols-2">
            {docs.map((d) => (
              <li>
                <a
                  href={docHref(lang, p.id, d)}
                  class="flex min-h-11 items-center justify-between gap-2 border-t border-[var(--color-border)] py-2 text-sm text-[var(--color-text)]/85 transition-colors hover:text-[var(--color-brand-1)]"
                >
                  <span>{d.label[lang]}</span>
                  {!d.locales.includes(lang) && (
                    <span class="rounded border border-cyan-500/30 bg-cyan-500/15 px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wider text-cyan-300">EN</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={productHomeHref(lang, p.id)}
            class="mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]"
          >
            {copy.open(productName(p, lang))}
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8" />
              <polyline points="9,4 13,8 9,12" />
            </svg>
          </a>
        </section>
      );
    })}
  </div>

  <div class="prose-tw">
  <h2>{copy.more}</h2>
  {zh ? (
    <ul>
      <li><a href="https://github.com/ThinkWatchProject/ThinkWatch">GitHub 仓库</a> —— 源码、Issues、Release</li>
      <li><a href={localePath(lang, "/changelog")}>更新日志</a> —— 各发布版本的变更记录</li>
      <li><a href="https://github.com/ThinkWatchProject/ThinkWatch/blob/main/LICENSING.md">LICENSING.md</a> —— 生产环境阈值与商业授权</li>
    </ul>
  ) : (
    <ul>
      <li><a href="https://github.com/ThinkWatchProject/ThinkWatch">GitHub repository</a> — source, issues, releases</li>
      <li><a href={localePath(lang, "/changelog")}>Changelog</a> — release notes for each version</li>
      <li><a href="https://github.com/ThinkWatchProject/ThinkWatch/blob/main/LICENSING.md">LICENSING.md</a> — production thresholds and commercial tiers</li>
    </ul>
  )}
  </div>
  </div>
</DocsLayout>
