---
// The Lite band on the home page. Each page shows the interface in its own
// language; see LitePage.astro.
import { getLang, localePath } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";

const lang = getLang(Astro);
const c = homeCopy[lang].lite;
const zh = lang === "zh-CN";
---

<section class="container-page grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-[72px] lg:py-28">
  <div class="order-2 min-w-0 lg:order-1">
    <img
      src={zh ? "/lite/overview.webp" : "/lite/overview-en.webp"}
      width="2360"
      height="1540"
      loading="lazy"
      decoding="async"
      class="w-full rounded-[10px]"
      alt={c.shotAlt}
    />
  </div>
  <div class="order-1 flex flex-col gap-5 lg:order-2">
    <div class="font-mono text-[13px] uppercase tracking-[0.08em] text-[var(--color-brand-1)]">{c.eyebrow}</div>
    <h2
      class:list={[
        "font-display text-white [text-wrap:balance]",
        lang === "zh-CN" ? "text-[28px] leading-[1.35] sm:text-[34px] lg:text-[40px]" : "text-[32px] leading-[1.15] sm:text-[40px] lg:text-[46px]",
      ]}
    >{c.title}</h2>
    <div class="mt-2 flex flex-col gap-4">
      {c.points.map((p) => (
        <p class="text-base leading-relaxed text-[#cbd5e1] sm:text-[17px]"><span class="font-semibold text-white">{p.t}</span> {p.b}</p>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-3">
      {c.pills.map((pill) => (
        <span class="rounded-full border border-[var(--color-border-strong)] px-3 py-1.5 text-[13px] text-[#cbd5e1]">{pill}</span>
      ))}
    </div>
    <a href={localePath(lang, "/lite")} class="inline-flex min-h-11 items-center self-start text-[17px] font-medium text-[var(--color-brand-1)] hover:text-[var(--color-brand-2)]">{c.cta}</a>
  </div>
</section>
