---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { t } from "~/i18n";

// GitHub Pages serves one static 404 for every language, so both copies are
// rendered and the inline script below shows the one the visitor prefers.
const en = t("en").notFound;
const zh = t("zh-CN").notFound;

// `path` is the English path; the script prefixes /zh-CN for Chinese visitors.
const links = [
  { path: "/", en: en.home, zh: zh.home, primary: true },
  { path: "/thinkwatch", en: en.thinkwatch, zh: zh.thinkwatch, primary: false },
  { path: "/lite", en: en.lite, zh: zh.lite, primary: false },
  { path: "/core", en: en.core, zh: zh.core, primary: false },
  { path: "/docs", en: en.docs, zh: zh.docs, primary: false },
];
---

<Base title={en.title} description={en.description} noindex>
  <SiteHeader />
  <main id="main" class="container-page relative overflow-hidden py-20 text-center md:py-28">
    <div
      class="pointer-events-none absolute left-1/2 top-1/3 h-[24rem] w-[24rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-gradient opacity-10 blur-[120px] md:h-[34rem] md:w-[34rem]"
      aria-hidden="true"
    ></div>

    <div class="relative">
      <div class="font-display text-gradient text-[8rem] leading-none sm:text-[10rem] md:text-[13rem] reveal" aria-hidden="true">
        404
      </div>
      <h1 class="font-display mt-4 text-3xl md:text-5xl reveal" style="animation-delay: 80ms">
        <span data-i18n="en">{en.headline}</span>
        <span data-i18n="zh-CN" hidden>{zh.headline}</span>
      </h1>
      <p class="mx-auto mt-4 max-w-md text-[var(--color-muted)] reveal" style="animation-delay: 160ms">
        <span data-i18n="en">{en.sub}</span>
        <span data-i18n="zh-CN" hidden>{zh.sub}</span>
      </p>

      <nav class="mt-10 reveal" style="animation-delay: 240ms">
        <h2 class="sr-only">
          <span data-i18n="en">{en.linksLabel}</span>
          <span data-i18n="zh-CN" hidden>{zh.linksLabel}</span>
        </h2>
        <ul class="mx-auto flex max-w-2xl flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
          {links.map((l) => (
            <li>
              <a
                href={l.path}
                data-localize={l.path}
                class:list={[
                  "inline-flex min-h-11 w-full items-center justify-center rounded-lg px-5 font-medium transition sm:w-auto",
                  l.primary
                    ? "bg-brand-gradient text-black hover:brightness-110"
                    : "border border-[var(--color-border-strong)] text-[var(--color-text)] hover:border-[var(--color-brand-1)] hover:text-[var(--color-brand-1)]",
                ]}
              >
                <span data-i18n="en">{l.en}</span>
                <span data-i18n="zh-CN" hidden>{l.zh}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- A real request for the missing path; the script fills in the path the visitor asked for. -->
      <pre class="mt-12 inline-block max-w-full overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-left font-mono text-xs text-[var(--color-dim)]"><span class="text-[var(--color-brand-1)]">$</span> curl -I https://thinkwat.ch<span data-request-path>{Astro.url.pathname}</span>
HTTP/2 404</pre>
    </div>
  </main>
  <SiteFooter />
</Base>

<script is:inline define:vars={{ enTitle: en.title, zhTitle: zh.title }}>
  (function () {
    try {
      // Show the path that was actually requested, not the build-time /404.
      var pathEl = document.querySelector("[data-request-path]");
      if (pathEl) pathEl.textContent = location.pathname;

      var stored = localStorage.getItem("tw-lang-pref");
      var pref = (stored === "en" || stored === "zh-CN")
        ? stored
        : ((navigator.language || "en").toLowerCase().indexOf("zh") === 0 ? "zh-CN" : "en");

      // Toggle visible spans
      document.querySelectorAll("[data-i18n]").forEach(function (el) {
        el.hidden = el.getAttribute("data-i18n") !== pref;
      });

      // Update <html lang> and <title>
      document.documentElement.lang = pref;
      document.title = pref === "zh-CN" ? zhTitle : enTitle;

      // Point every link at the Chinese site for Chinese visitors
      if (pref === "zh-CN") {
        document.querySelectorAll("[data-localize]").forEach(function (a) {
          var path = a.getAttribute("data-localize") || "/";
          a.setAttribute("href", path === "/" ? "/zh-CN/" : "/zh-CN" + path);
        });
      }
    } catch (e) {}
  })();
</script>
