---
// ThinkWatch (server edition) release notes, English.
// Keep the markup in sync with src/pages/zh-CN/changelog/index.astro.
import { getCollection, render } from "astro:content";
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const typeStyles: Record<string, string> = {
  release: "border-brand-1/40 bg-brand-1/10 text-brand-1",
  feature: "border-white/15 bg-white/5 text-[var(--color-text)]",
  fix: "border-emerald-500/30 bg-emerald-500/10 text-emerald-300",
  security: "border-accent/40 bg-accent/10 text-accent",
};

const fmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });

const filterTypes = [
  { id: "all", label: "All" },
  { id: "release", label: "Release" },
  { id: "feature", label: "Feature" },
  { id: "fix", label: "Fix" },
  { id: "security", label: "Security" },
];
---

<Base
  title="ThinkWatch release notes · Changelog"
  description="Release notes for each version of ThinkWatch, the self-hosted AI gateway for organizations, listed from newest to oldest."
>
  <SiteHeader />
  <main id="main" class="container-page py-16 md:py-24">
    <header class="max-w-3xl">
      <div class="font-mono text-xs sm:text-[13px] uppercase tracking-[0.08em] text-[var(--color-brand-1)] reveal">
        Changelog
      </div>
      <h1 class="font-display mt-5 text-4xl leading-[1.1] md:text-[56px] reveal" style="animation-delay: 80ms">
        ThinkWatch <span class="text-gradient">release notes</span>
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)] reveal" style="animation-delay: 160ms">
        Release notes for each ThinkWatch version, the self-hosted gateway for organizations, listed from newest to oldest. Subscribe via
        <a href="/changelog.xml" class="text-[var(--color-text)] underline underline-offset-4 hover:text-[var(--color-brand-1)]">RSS</a>.
      </p>
    </header>

    <div class="mt-10 md:mt-12 flex flex-wrap gap-2" role="group" aria-label="Filter release notes by type">
      {filterTypes.map((f, i) => (
        <button
          type="button"
          data-filter-btn={f.id}
          aria-pressed={i === 0 ? "true" : "false"}
          class="filter-btn inline-flex min-h-11 items-center rounded-full border border-white/15 px-4 text-sm font-medium text-[var(--color-muted)] transition-colors hover:border-white/30 hover:text-[var(--color-text)]"
        >
          {f.label}
        </button>
      ))}
    </div>

    <ol class="changelog-list mt-12 max-w-3xl space-y-12" data-filter="all">
      {entries.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <li
            id={`v${entry.data.version}`}
            data-type={entry.data.type}
            class="changelog-item relative scroll-mt-24 border-l border-[var(--color-border-strong)] pl-6 sm:pl-8"
          >
            <a
              href={`#v${entry.data.version}`}
              class="timeline-dot absolute -left-[5px] top-2 size-2.5 rounded-full bg-[var(--color-brand-1)] ring-4 ring-[var(--color-bg)] transition-transform hover:scale-125"
              aria-label={`Link to v${entry.data.version}`}
            ></a>

            <div class="mb-3 flex flex-wrap items-center gap-3">
              <span class="font-mono text-sm text-[var(--color-text)]">v{entry.data.version}</span>
              <span class={`rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-wider ${typeStyles[entry.data.type]}`}>
                {entry.data.type}
              </span>
              <time class="text-xs text-[var(--color-dim)]" datetime={entry.data.date.toISOString()}>
                {fmt.format(entry.data.date)}
              </time>
            </div>

            <h2 class="mb-3 text-2xl font-semibold tracking-tight text-[var(--color-text)]">{entry.data.title}</h2>

            {entry.data.highlights && (
              <ul class="mb-4 space-y-1.5 text-sm text-[var(--color-muted)]">
                {entry.data.highlights.map((h) => (
                  <li class="flex gap-2">
                    <span class="text-[var(--color-brand-1)]" aria-hidden="true">›</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="prose prose-invert prose-sm max-w-none text-[var(--color-muted)]">
              <Content />
            </div>
          </li>
        );
      })}
    </ol>
  </main>
  <SiteFooter />
</Base>

<style>
  .changelog-list[data-filter="release"]  .changelog-item:not([data-type="release"]),
  .changelog-list[data-filter="feature"]  .changelog-item:not([data-type="feature"]),
  .changelog-list[data-filter="fix"]      .changelog-item:not([data-type="fix"]),
  .changelog-list[data-filter="security"] .changelog-item:not([data-type="security"]) {
    display: none;
  }

  /* Active filter pill: teal. Driven by aria-pressed so the script only flips that attribute. */
  .filter-btn[aria-pressed="true"] {
    border-color: var(--color-brand-1);
    background: color-mix(in oklab, var(--color-brand-1) 14%, transparent);
    color: var(--color-brand-1);
  }
  .filter-btn:focus-visible {
    outline: 2px solid var(--color-brand-1);
    outline-offset: 2px;
  }

  /* The dot is 10px; give its anchor a larger invisible hit area. */
  .timeline-dot::before {
    content: "";
    position: absolute;
    inset: -14px;
  }

  /* Section headings inside changelog body */
  .changelog-item :global(h2) {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-1);
    margin-top: 1.25rem;
    margin-bottom: 0.375rem;
  }
  .changelog-item :global(h2:first-child) {
    margin-top: 0;
  }

  /* Hide the # anchor link appended by rehypeAutolinkHeadings */
  .changelog-item :global(.heading-anchor) {
    display: none;
  }
</style>

<script>
  const list = document.querySelector(".changelog-list");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]");
  if (list && buttons.length) {
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        list.setAttribute("data-filter", btn.dataset.filterBtn || "all");
        buttons.forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
      });
    });
  }
</script>
