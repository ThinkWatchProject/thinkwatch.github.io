---
// The /core page: ThinkWatch Core, the MIT-licensed Rust crates and the twcore
// binary shared by ThinkWatch Lite and ThinkWatch Enterprise.
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { getLang, localePath } from "~/i18n";
import { coreCopy } from "~/i18n/pages/core";
import { coreLd } from "~/lib/structured-data";

const lang = getLang(Astro);
const c = coreCopy[lang];
const zh = lang === "zh-CN";

const repo = "https://github.com/ThinkWatchProject/ThinkWatch-Core";
const docsHref = localePath(lang, "/docs/core");
const jsonLd = await coreLd(lang);

const delay = (i: number) => `animation-delay: ${i * 90}ms;`;
const eyebrow = "font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted)] sm:text-[13px]";
const h2 = zh
  ? "font-display m-0 text-[26px] leading-[1.35] sm:text-[32px] lg:text-[36px]"
  : "font-display m-0 text-[30px] leading-[1.15] sm:text-[36px] lg:text-[40px]";
const textLink =
  "inline-flex min-h-11 items-center text-[17px] font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]";
---

<Base title={c.meta.title} description={c.meta.description} ogCard="core" jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="relative overflow-hidden">
      <div class="container-page grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16 lg:py-[88px]">
        <div class="flex min-w-0 flex-col gap-5 sm:gap-6">
          <p class="reveal m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-brand-1)] sm:text-[13px]" style={delay(0)}>
            {c.hero.eyebrow}
          </p>
          <h1
            class:list={[
              "reveal font-display m-0 text-[var(--color-text)]",
              zh
                ? "text-[30px] leading-[1.35] sm:text-[40px] lg:text-[48px]"
                : "text-[36px] leading-[1.1] sm:text-[46px] lg:text-[56px] lg:leading-[1.05]",
            ]}
            style={delay(1)}
          >
            {c.hero.titleA}<span class="text-shimmer">{c.hero.titleHighlight}</span>
          </h1>
          <p class="reveal m-0 max-w-[36rem] text-[17px] leading-relaxed text-[#cbd5e1] sm:text-xl sm:leading-normal" style={delay(2)}>
            {c.hero.sub}
          </p>
          <div class="reveal mt-1 flex flex-col gap-3 sm:mt-2 sm:flex-row sm:items-center sm:gap-5" style={delay(3)}>
            <a
              href={docsHref}
              class="inline-flex min-h-11 items-center justify-center rounded-[10px] bg-[var(--color-brand-1)] px-[22px] py-3 text-base font-semibold text-[var(--color-bg)] transition-colors hover:bg-[var(--color-brand-2)]"
            >
              {c.hero.ctaPrimary}
            </a>
            <a
              href={repo}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center justify-center text-base font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)] sm:justify-start"
            >
              {c.hero.ctaSecondary}
            </a>
          </div>
        </div>

        <div
          class="reveal min-w-0 overflow-hidden rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] font-mono text-[13px] sm:text-[15px]"
          style={delay(3)}
        >
          <div class="flex items-center gap-2.5 border-b border-[#22304f] px-5 py-3.5 text-[var(--color-muted)] sm:px-[22px]">
            <span class="h-2 w-2 shrink-0 rounded-full bg-[var(--color-brand-1)] pulse-dot" aria-hidden="true"></span>
            <span class="min-w-0">{c.hero.cardTitle}</span>
          </div>
          <div class="overflow-x-auto">
            <ol class="m-0 flex list-none flex-col gap-3.5 px-5 py-6 leading-normal sm:px-[22px]">
              {c.hero.commands.map((row, i) => (
                <li class="reveal flex flex-col gap-0.5 whitespace-nowrap" style={delay(5 + i * 2)}>
                  <code class:list={[i === c.hero.commands.length - 1 ? "text-[var(--color-brand-1)]" : "text-[#e6ebf2]"]}>
                    {row.cmd}
                  </code>
                  <span class="text-[var(--color-muted)]">{row.note}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-[var(--color-border)] py-16 sm:py-20 lg:py-[88px]" aria-labelledby="core-does">
      <div class="container-page">
        <h2 id="core-does" class:list={[eyebrow, "m-0 font-normal"]}>{c.does.eyebrow}</h2>
        <div class="mt-8 grid gap-7 sm:grid-cols-2 lg:grid-cols-5">
          {c.does.items.map((item) => (
            <div class="flex flex-col gap-2.5 border-t border-[var(--color-border-strong)] pt-[18px]">
              <h3 class="m-0 text-lg font-semibold sm:text-[19px]">{item.title}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-[var(--color-muted)]">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-surface)] py-16 sm:py-20 lg:py-[88px]" aria-labelledby="core-layers">
      <div class="container-page">
        <h2 id="core-layers" class:list={[eyebrow, "m-0 font-normal"]}>{c.layers.eyebrow}</h2>
        <ol class="m-0 mt-8 flex list-none flex-col gap-3 p-0">
          {c.layers.rows.map((row, i) => (
            <li
              class:list={[
                "grid items-start gap-2.5 rounded-xl border px-5 py-5 sm:px-[26px] sm:py-[22px] lg:grid-cols-[260px_minmax(0,1fr)_240px] lg:items-center lg:gap-6",
                i === 0 ? "border-[var(--color-brand-1)]" : "border-[var(--color-border-strong)]",
              ]}
            >
              <span class="text-[17px] font-semibold">{row.name}</span>
              <code class="break-words font-mono text-sm leading-relaxed text-[#cbd5e1] sm:text-[15px]">{row.crates}</code>
              {i === 0 ? (
                <span class="justify-self-start rounded-full border border-[var(--color-brand-1)] px-[11px] py-[5px] text-[13px] text-[var(--color-brand-1)] lg:justify-self-end">
                  {c.layers.sharedTag}
                </span>
              ) : i >= 2 ? (
                <span class="text-[13px] text-[var(--color-muted)] lg:justify-self-end lg:text-right">{c.layers.localNote}</span>
              ) : (
                <span class="hidden lg:block" aria-hidden="true"></span>
              )}
            </li>
          ))}
        </ol>
        <p class="m-0 mt-6 max-w-3xl text-[15px] leading-relaxed text-[var(--color-muted)]">{c.layers.footnote}</p>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-[88px]">
      <div class="container-page grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col gap-4">
          <p class:list={[eyebrow, "m-0"]}>{c.dev.eyebrow}</p>
          <h2 class={h2}>{c.dev.title}</h2>
          <p class="m-0 text-base leading-relaxed text-[#cbd5e1] sm:text-[17px]">{c.dev.body}</p>
        </div>
        <div class="overflow-x-auto rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] p-5 font-mono text-[13px] leading-normal sm:p-7 sm:text-[15px]">
          <ul class="m-0 flex list-none flex-col gap-3.5 p-0">
            {c.dev.commands.map((row) => (
              <li class="flex flex-col gap-0.5 whitespace-nowrap">
                <code class="text-[#e6ebf2]">{row.cmd}</code>
                <span class="text-[var(--color-muted)]">{row.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pb-16 sm:pb-20 lg:pb-[88px]">
      <div class="container-page">
        <div class="flex flex-col gap-4 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-10">
          <div class="flex flex-col gap-1.5">
            <h2 class="m-0 text-xl font-semibold sm:text-[22px]">{c.license.title}</h2>
            <p class="m-0 text-base text-[var(--color-muted)] sm:text-[17px]">{c.license.body}</p>
          </div>
          <a href={repo} target="_blank" rel="noopener" class:list={[textLink, "shrink-0"]}>
            {c.license.link}
            <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
