---
// The /sponsors page: the sponsors of ThinkWatch Lite and how to become one.
// Copy and the sponsor list live in src/i18n/pages/sponsors.ts.
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import NeonMotion from "~/components/NeonMotion.astro";
import { getLang, sponsorHref } from "~/i18n";
import { sponsors, sponsorsCopy } from "~/i18n/pages/sponsors";
import { breadcrumbs, webPage } from "~/lib/structured-data";

const lang = getLang(Astro);
const c = sponsorsCopy[lang];
const reportHref = sponsorHref.replace("Sponsorship", "Sponsor%20Report");

const jsonLd = [
  webPage(lang, "/sponsors", c.meta.title, c.meta.description),
  breadcrumbs(lang, "/sponsors", c.meta.breadcrumbHome, c.meta.breadcrumbPage),
];
---

<Base title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="nx-hero sp-hero">
      <div class="nx-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="nx-gridbg" aria-hidden="true"></div>
      <div class="container-page">
        <p class="nx-label nx-rise">{c.hero.eyebrow}</p>
        <h1 class="nx-h1 sp-h1 nx-rise" style="--d:1"><span class="nx-grad">{c.hero.title}</span></h1>
        <p class="nx-sub nx-rise" style="--d:2">{c.hero.sub}</p>

        <!-- One row per sponsor: its logo on its own black plate, then its tagline, description and site -->
        <div class="sp-list nx-rise" style="--d:3">
          {sponsors.map((s) => {
            const e = c.entries[s.name];
            return (
              <article class="nx-tile sp-card">
                <a href={s.href} target="_blank" rel="sponsored noopener" class="sp-plate">
                  <img src={s.logo} alt={s.name} width={s.logoWidth / 3} height={s.logoHeight / 3} />
                </a>
                <div class="sp-content">
                  <h2 class="sp-tagline">{e.tagline}</h2>
                  <p class="nx-body">{e.body}</p>
                  <a href={s.href} target="_blank" rel="sponsored noopener" class="nx-link sp-site">{e.visit}</a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Where sponsors appear, and the contact -->
    <section class="nx-section-tight nx-hairline">
      <div class="container-page sp-become">
        <div>
          <h2 class="nx-h3">{c.become.title}</h2>
          <p class="nx-body">{c.become.body}</p>
          <p class="nx-body">{c.become.note}</p>
        </div>
        <a href={sponsorHref} class="nx-ghost sp-mail">{c.become.contactLabel}</a>
      </div>
    </section>

    <!-- What the project does and does not answer for -->
    <section id="disclaimer" class="nx-section-tight nx-hairline sp-disclaimer">
      <div class="container-page">
        <h2 class="nx-h3">{c.disclaimer.title}</h2>
        {c.disclaimer.body.map((p) => <p class="nx-body">{p}</p>)}
        <p class="nx-body">{c.disclaimer.report.lead}<a href={reportHref} class="sp-inline-link">{c.disclaimer.report.label}</a>{c.disclaimer.report.end}</p>
      </div>
    </section>
  </main>
  <SiteFooter />
  <NeonMotion />
</Base>

<style>
  .sp-hero {
    padding-bottom: 72px;
  }
  .sp-h1 {
    margin-top: 16px;
  }
  .sp-list {
    margin-top: 44px;
    display: grid;
    gap: 12px;
  }
  /* Plate and copy side by side, the plate on top on narrow screens */
  .sp-card {
    display: grid;
    padding: 0;
  }
  @media (min-width: 768px) {
    .sp-card {
      grid-template-columns: 300px minmax(0, 1fr);
    }
  }
  /* The sponsor's own plate: its logo on black */
  .sp-plate {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 140px;
    padding: 24px;
    background: radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 60%), #050505;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 768px) {
    .sp-plate {
      border-bottom: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
    }
  }
  .sp-plate img {
    display: block;
    width: 210px;
    max-width: 100%;
    height: auto;
  }
  .sp-content {
    position: relative;
    padding: 26px 32px 22px;
  }
  @media (max-width: 639px) {
    .sp-content {
      padding: 22px 22px 18px;
    }
  }
  .sp-tagline {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }
  .sp-card .nx-body {
    margin-top: 8px;
    max-width: 720px;
  }
  .sp-site {
    margin-top: 4px;
  }
  .sp-become {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .sp-become > div {
    max-width: 680px;
  }
  .sp-disclaimer {
    scroll-margin-top: 5rem;
  }
  .sp-inline-link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.25);
    text-underline-offset: 3px;
  }
  .sp-inline-link:hover {
    color: #fff;
  }
  .sp-disclaimer .nx-body {
    max-width: 760px;
    font-size: 14px;
  }
</style>
