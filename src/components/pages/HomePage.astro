---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import HomeHero from "~/components/home/HomeHero.astro";
import Marquee from "~/components/home/Marquee.astro";
import FlowSection from "~/components/home/FlowSection.astro";
import Questions from "~/components/home/Questions.astro";
import ThinkWatchBand from "~/components/home/ThinkWatchBand.astro";
import LiteBand from "~/components/home/LiteBand.astro";
import CoreStrip from "~/components/home/CoreStrip.astro";
import CompareEditions from "~/components/home/CompareEditions.astro";
import { getLang } from "~/i18n";

const lang = getLang(Astro);
const home = new URL(Astro.url.pathname, Astro.site).toString();

// The home page introduces all three products, so it describes each of them
// instead of the default ThinkWatch-only SoftwareApplication.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "ThinkWatch",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS, Windows (via Docker / Kubernetes)",
    url: "https://thinkwat.ch/thinkwatch",
    downloadUrl: "https://github.com/ThinkWatchProject/ThinkWatch",
    license: "https://github.com/ThinkWatchProject/ThinkWatch/blob/main/LICENSE",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "ThinkWatch Lite",
    url: "https://thinkwat.ch/lite",
    codeRepository: "https://github.com/ThinkWatchProject/ThinkWatch-Lite",
    programmingLanguage: ["TypeScript", "Rust"],
    license: "https://opensource.org/licenses/MIT",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "ThinkWatch Core",
    url: "https://thinkwat.ch/core",
    codeRepository: "https://github.com/ThinkWatchProject/ThinkWatch-Core",
    programmingLanguage: "Rust",
    license: "https://opensource.org/licenses/MIT",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    url: home,
    inLanguage: lang,
  },
];
---

<Base noJsonLd jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <HomeHero />
    <Marquee />
    <FlowSection />
    <Questions />
    <ThinkWatchBand />
    <LiteBand />
    <CoreStrip />
    <CompareEditions />
  </main>
  <SiteFooter />
</Base>
