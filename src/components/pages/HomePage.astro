---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import HomeHero from "~/components/home/HomeHero.astro";
import Marquee from "~/components/home/Marquee.astro";
import Questions from "~/components/home/Questions.astro";
import ThinkWatchBand from "~/components/home/ThinkWatchBand.astro";
import LiteBand from "~/components/home/LiteBand.astro";
import CoreStrip from "~/components/home/CoreStrip.astro";
import CompareEditions from "~/components/home/CompareEditions.astro";
import { getLang } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";
import { coreLd, enterpriseLd, liteLd, webPage, website } from "~/lib/structured-data";

const lang = getLang(Astro);
const c = homeCopy[lang];

// The home page introduces all three products, so it describes each of them,
// the same way their own pages do.
const jsonLd = [
  website,
  webPage(lang, "/", c.meta.title, c.meta.description),
  ...(await enterpriseLd(lang)),
  ...(await liteLd(lang)),
  ...(await coreLd(lang)),
];
---

<Base title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <HomeHero />
    <Marquee />
    <Questions />
    <ThinkWatchBand />
    <LiteBand />
    <CoreStrip />
    <CompareEditions />
  </main>
  <SiteFooter />
</Base>
