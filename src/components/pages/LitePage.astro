---
// The /lite product page: ThinkWatch Lite, the desktop app for individual
// developers on macOS, Windows and Linux. Status copy must stay in line with the Lite
// README; how the copy is checked is described in src/i18n/pages/lite.ts.
//
// Each page shows the interface in its own language: the app ships in both,
// and a screenshot of the other one says little to the reader. The images in
// public/lite come from the Lite repository's docs/screenshots/web: window
// shots are 2360×1540, the menu 664×1120, the menu bar item 178×64, all at
// twice the size they are shown at.
import LiteDownload from "~/components/LiteDownload.astro";
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { getLang, localePath, t } from "~/i18n";
import { liteCopy } from "~/i18n/pages/lite";
import { getLatestLiteRelease } from "~/lib/github";
import { liteLd } from "~/lib/structured-data";

const lang = getLang(Astro);
const c = liteCopy[lang];
const ui = t(lang).common;
const zh = lang === "zh-CN";
/** 英文界面的那一套图带 `-en`，见文件头 */
const shot = (id: string) => `/lite/${id}${zh ? "" : "-en"}.webp`;

const repo = "https://github.com/ThinkWatchProject/ThinkWatch-Lite";
const releases = `${repo}/releases`;
const latestPage = `${releases}/latest`;

// Windows installers of the latest release. The file names carry the version,
// so they come from the release's asset list, looked up at build time; without
// it, the buttons lead to the latest release page instead.
const liteRelease = await getLatestLiteRelease();
const assetUrl = (suffix: string) => {
  const name = Object.keys(liteRelease?.assets ?? {}).find((n) => n.endsWith(suffix));
  return name ? liteRelease!.assets[name] : null;
};
const winArchs = ["x64", "arm64"] as const;
const win = Object.fromEntries(
  winArchs.map((arch) => [
    arch,
    { url: assetUrl(`-${arch}-setup.exe`) ?? latestPage, sha: assetUrl(`-${arch}-setup.exe.sha256`) },
  ]),
) as Record<(typeof winArchs)[number], { url: string; sha: string | null }>;
const linuxArchs = ["x86_64", "aarch64"] as const;
const linux = Object.fromEntries(
  linuxArchs.map((arch) => [
    arch,
    { url: assetUrl(`-${arch}.AppImage`) ?? latestPage, sha: assetUrl(`-${arch}.AppImage.sha256`) },
  ]),
) as Record<(typeof linuxArchs)[number], { url: string; sha: string | null }>;
const installScript = `${latestPage}/download/install.sh`;
const dmg = { url: assetUrl("-arm64.dmg") ?? latestPage, sha: assetUrl("-arm64.dmg.sha256") };
const liteVersion = liteRelease?.tag.replace(/^v/, "") ?? null;
const installDocsHref = localePath(lang, "/docs/lite/install");
const sourceDocsHref = localePath(lang, "/docs/lite/run-from-source");
const remoteDocsHref = localePath(lang, "/docs/lite/remote-core");
/** Installing and running twcore on a Linux server, in the Core docs */
const serverDocsHref = localePath(lang, "/docs/core/server-deployment");
const jsonLd = await liteLd(lang);

const delay = (i: number) => `animation-delay: ${i * 90}ms;`;
const eyebrow = "font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted)] sm:text-[13px]";
const h2 = zh
  ? "font-display m-0 text-[26px] leading-[1.35] sm:text-[32px] lg:text-[36px]"
  : "font-display m-0 text-[30px] leading-[1.15] sm:text-[36px] lg:text-[40px]";
const textLink =
  "inline-flex min-h-11 items-center text-[17px] font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]";
const nodes = [c.built.lite, c.built.core, c.built.upstreams];
/** 截图外的一圈：和窗口自带的阴影配合，不再加边框 */
const shotClass = "w-full rounded-[10px]";
const archLabel = { x64: "x64", arm64: "ARM64" } as const;
---

<Base title={c.meta.title} description={c.meta.description} ogCard="lite" jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="relative overflow-hidden">
      <div class="container-page grid items-center gap-12 pb-12 pt-14 sm:pb-16 sm:pt-20 lg:grid-cols-2 lg:gap-16 lg:pb-[72px] lg:pt-[88px]">
        <div class="flex min-w-0 flex-col gap-5 sm:gap-6">
          <p class="reveal m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-brand-1)] sm:text-[13px]" style={delay(0)}>
            {c.hero.eyebrow}
          </p>
          <h1
            class:list={[
              "reveal font-display m-0 text-[var(--color-text)] [text-wrap:balance]",
              zh
                ? "text-[30px] leading-[1.35] sm:text-[40px] lg:text-[48px]"
                : "text-[36px] leading-[1.1] sm:text-[46px] lg:text-[56px] lg:leading-[1.05]",
            ]}
            style={delay(1)}
          >
            {/* Chinese breaks between any two characters: keep the highlighted noun on one line. */}
            {c.hero.titleA}<span class:list={["text-shimmer", zh && "whitespace-nowrap"]}>{c.hero.titleHighlight}</span>
          </h1>
          <p class="reveal m-0 max-w-[36rem] text-[17px] leading-relaxed text-[#cbd5e1] sm:text-xl sm:leading-normal" style={delay(2)}>
            {c.hero.sub}
          </p>
          <div class="reveal mt-1 flex flex-col gap-3 sm:mt-2 sm:flex-row sm:items-start sm:gap-5" style={delay(3)}>
            {/* 直接下载这台机器要的那个文件；认不出、或者没有对应的包时去安装一节 */}
            <LiteDownload />
            <a
              href="#install"
              class="inline-flex min-h-11 items-center justify-center text-base font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)] sm:justify-start"
            >
              {c.hero.ctaSecondary}
            </a>
          </div>
        </div>
        <div class="reveal min-w-0" style={delay(3)}>
          <img
            src={shot("overview")}
            width="2360"
            height="1540"
            class={shotClass}
            fetchpriority="high"
            alt={c.hero.shotAlt}
          />
        </div>
      </div>
    </section>

    <div class="container-page">
      <div
        class="reveal flex flex-col items-start gap-4 rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-5 sm:px-7 sm:py-6 lg:flex-row lg:gap-8"
        style={delay(5)}
      >
        <span class="shrink-0 rounded-full bg-[var(--color-brand-1)] px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.06em] text-[var(--color-bg)]">
          {c.status.badge}
        </span>
        {/* 每栏一个标签：外人一眼看出哪几项是平台、哪一项是语言或许可证 */}
        <dl class="m-0 grid w-full gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))]">
          {c.status.items.map((item) => (
            <div class="flex min-w-0 flex-col gap-1">
              <dt class="text-[13px] text-[var(--color-muted)]">{item.label}</dt>
              {item.lines.map((line) => (
                <dd class="m-0 text-[15px] leading-relaxed text-[#cbd5e1]">{line}</dd>
              ))}
            </div>
          ))}
        </dl>
      </div>
    </div>

    <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="lite-shows">
      <div class="container-page">
        <h2 id="lite-shows" class:list={[eyebrow, "m-0 font-normal"]}>{c.features.eyebrow}</h2>
        <div class="mt-8 flex flex-col gap-14 sm:gap-20">
          {c.features.items.map((item, i) => (
            <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-14">
              <div class:list={["flex min-w-0 flex-col gap-3", i % 2 === 1 && "lg:order-2"]}>
                <h3 class="m-0 text-xl font-semibold leading-snug tracking-tight sm:text-2xl">{item.title}</h3>
                <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{item.body}</p>
              </div>
              <img
                src={shot(item.id)}
                width="2360"
                height="1540"
                loading="lazy"
                decoding="async"
                class={shotClass}
                alt={item.alt}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-[var(--color-border-strong)] py-16 sm:py-20 lg:py-24" aria-labelledby="lite-remote">
      <div class="container-page flex flex-col gap-12 sm:gap-14">
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
          <div class="flex min-w-0 flex-col gap-4">
            <p class:list={[eyebrow, "m-0"]}>{c.remote.eyebrow}</p>
            <h2 id="lite-remote" class={h2}>{c.remote.title}</h2>
            {c.remote.body.map((p) => (
              <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{p}</p>
            ))}
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
              <a href={serverDocsHref} class={textLink}>{c.remote.serverDocs}</a>
              <a href={remoteDocsHref} class={textLink}>{c.remote.docs}</a>
            </div>
          </div>
          <img
            src={shot("remote-add")}
            width="2360"
            height="1540"
            loading="lazy"
            decoding="async"
            class={shotClass}
            alt={c.remote.addAlt}
          />
        </div>
        <div class="grid gap-10 md:grid-cols-2 lg:gap-14">
          {c.remote.figures.map((figure) => (
            <figure class="m-0 flex min-w-0 flex-col gap-3">
              <img
                src={shot(figure.id)}
                width="2360"
                height="1540"
                loading="lazy"
                decoding="async"
                class={shotClass}
                alt={figure.alt}
              />
              <figcaption class="text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">{figure.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-16 sm:pb-20 lg:pb-24" aria-labelledby="lite-menubar">
      <div class="container-page grid items-center gap-8 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14">
        <div class="flex min-w-0 flex-col gap-3">
          <p class:list={[eyebrow, "m-0"]}>{c.menubar.eyebrow}</p>
          <h2 id="lite-menubar" class={h2}>{c.menubar.title}</h2>
          {/* The menu bar item at its real size: the bitmap is drawn at 2×, 89 × 32 points. */}
          <img src="/lite/menubar.png" width="178" height="64" loading="lazy" class="my-2 h-auto w-[89px]" alt={c.menubar.chipAlt} />
          <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{c.menubar.body}</p>
          <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{c.menubar.notices}</p>
        </div>
        <img
          src={shot("menubar-menu")}
          width="664"
          height="1120"
          loading="lazy"
          decoding="async"
          class="mx-auto h-auto w-[332px] max-w-full"
          alt={c.menubar.menuAlt}
        />
      </div>
    </section>

    <section class="bg-[var(--color-surface)] py-16 sm:py-20 lg:py-[88px]" aria-labelledby="lite-built">
      <div class="container-page">
        <h2 id="lite-built" class:list={[eyebrow, "m-0 font-normal"]}>{c.built.eyebrow}</h2>
        <div class="mt-8 grid items-stretch lg:mt-10 lg:grid-cols-[minmax(0,1fr)_216px_minmax(0,1fr)_96px_minmax(0,1fr)] lg:items-center">
          {nodes.map((node, i) => (
            <Fragment>
              {i > 0 && (
                <div
                  class="flow-link relative flex flex-col items-center justify-center gap-3 py-3 lg:py-0"
                  data-active={i === 1 ? "true" : undefined}
                  aria-hidden={i === 1 ? undefined : "true"}
                >
                  <div
                    class:list={[
                      "flow-line relative h-10 w-px lg:h-px lg:w-full",
                      i === 1 ? "bg-[var(--color-brand-1)]" : "bg-[var(--color-border-strong)]",
                    ]}
                  >
                    {i === 1 && <span class="flow-dot" aria-hidden="true"></span>}
                  </div>
                  {/* The channel between the app and core: under the line when the nodes sit
                      side by side, below the vertical line when they are stacked. */}
                  {i === 1 && (
                    <div class="text-center font-mono text-xs leading-relaxed text-[var(--color-muted)] lg:absolute lg:inset-x-2 lg:top-[calc(50%+12px)]">
                      <p class="m-0 text-[var(--color-text)]">{c.built.link.title}</p>
                      <ul class="m-0 list-none p-0">
                        {c.built.link.lines.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}
              <div
                class:list={[
                  "flex flex-col gap-2.5 rounded-[14px] border bg-[var(--color-bg)]/30 p-6 sm:p-7",
                  i === 0 ? "border-[var(--color-brand-1)]" : "border-[var(--color-border-strong)]",
                ]}
              >
                <h3 class="m-0 text-xl font-semibold sm:text-[22px]">{node.title}</h3>
                <p class="m-0 text-[15px] leading-normal text-[var(--color-muted)]">{node.body}</p>
              </div>
            </Fragment>
          ))}
        </div>
      </div>
    </section>

    <section id="install" data-os="mac" class="scroll-mt-20 py-16 sm:py-20 lg:py-[88px]">
      <div class="container-page flex flex-col gap-8">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
          <div class="flex min-w-0 flex-col gap-3">
            <p class:list={[eyebrow, "m-0"]}>{c.install.eyebrow}</p>
            <h2 class={h2}>{c.install.title}</h2>
            <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{c.install.intro}</p>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-x-6 gap-y-1">
            <a href={installDocsHref} class={textLink}>{c.install.docs}</a>
            <a href={sourceDocsHref} class={textLink}>{c.install.source}</a>
            <a href={releases} target="_blank" rel="noopener" class={textLink}>{c.install.releases}</a>
          </div>
        </div>

        {/* 一个系统一栏，默认选中访客自己的系统（见页尾脚本）；没有脚本时三栏都显示 */}
        <div role="tablist" aria-label={c.install.tabsLabel} class="install-tabs" data-install-tabs hidden>
          {(["mac", "windows", "linux"] as const).map((os) => (
            <button type="button" role="tab" id={`install-tab-${os}`} aria-controls={`install-${os}`} data-tab={os}>
              {c.install.tabs[os]}
            </button>
          ))}
        </div>

        <div class="flex flex-col gap-12">
          <div id="install-mac" role="tabpanel" aria-labelledby="install-tab-mac" class="install-panel" data-panel="mac">
            <p class="install-req">{c.install.mac.req}</p>
            <div class="grid gap-4 lg:grid-cols-[3fr_2fr]">
              <div class="install-card">
                <div class="flex items-center gap-2.5">
                  <h3 class="install-card-title">{c.install.mac.brewTitle}</h3>
                  <span class="install-tag">{c.install.recommended}</span>
                </div>
                <p class="install-card-body">{c.install.mac.brewBody}</p>
                <div class="install-cmd">
                  <code><span class="select-none text-[var(--color-dim)]">$ </span><span data-cmd>brew install --cask thinkwatchproject/tap/thinkwatch-lite</span></code>
                  <button type="button" class="copy-cmd" data-copy="brew install --cask thinkwatchproject/tap/thinkwatch-lite" data-copied-label={ui.copied}>{ui.copy}</button>
                </div>
              </div>
              <div class="install-card">
                <h3 class="install-card-title">{c.install.mac.dmgTitle}</h3>
                <p class="install-card-body">{c.install.mac.dmgBody}</p>
                <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2">
                  <a href={dmg.url} class="dl-button">{c.install.mac.dmgDownload}</a>
                  {liteVersion && (
                    <p class="install-meta">
                      {c.install.version} {liteVersion}
                      {dmg.sha && <Fragment>{" · "}<a href={dmg.sha}>{c.install.sha}</a></Fragment>}
                    </p>
                  )}
                </div>
              </div>
            </div>
            <p class="install-note">{c.install.mac.note}</p>
          </div>

          <div id="install-windows" role="tabpanel" aria-labelledby="install-tab-windows" class="install-panel" data-panel="windows">
            <p class="install-req">{c.install.windows.req}</p>
            <div class="install-card">
              <h3 class="install-card-title">{c.install.windows.title}</h3>
              <p class="install-card-body">{c.install.windows.body}</p>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                {winArchs.map((arch) => (
                  <a href={win[arch].url} class="dl-button dl-primary" data-win-arch={arch} hidden={arch !== "x64"}>
                    {c.install.windows.download[arch]}
                  </a>
                ))}
                {winArchs.map((arch) => (
                  <p class="install-meta" data-win-other={arch} hidden={arch === "x64"}>
                    {c.install.other}<a href={win[arch].url}>{c.install.windows.otherLink[arch]}</a>
                  </p>
                ))}
              </div>
              {liteVersion && (
                <p class="install-meta">
                  {c.install.version} {liteVersion}
                  {winArchs.map((arch) =>
                    win[arch].sha && <Fragment>{" · "}<a href={win[arch].sha}>{c.install.sha} ({archLabel[arch]})</a></Fragment>,
                  )}
                </p>
              )}
            </div>
            <p class="install-note">{c.install.windows.note}</p>
          </div>

          <div id="install-linux" role="tabpanel" aria-labelledby="install-tab-linux" class="install-panel" data-panel="linux">
            <p class="install-req">{c.install.linux.req}</p>
            <div class="grid gap-4">
              <div class="install-card">
                <div class="flex items-center gap-2.5">
                  <h3 class="install-card-title">{c.install.linux.scriptTitle}</h3>
                  <span class="install-tag">{c.install.recommended}</span>
                </div>
                <p class="install-card-body">{c.install.linux.scriptBody}</p>
                <div class="install-cmd">
                  <code><span class="select-none text-[var(--color-dim)]">$ </span><span data-cmd>curl -fsSL {installScript} | sh</span></code>
                  <button type="button" class="copy-cmd" data-copy={`curl -fsSL ${installScript} | sh`} data-copied-label={ui.copied}>{ui.copy}</button>
                </div>
              </div>
              <div class="install-card">
                <h3 class="install-card-title">{c.install.linux.appimageTitle}</h3>
                <p class="install-card-body">{c.install.linux.appimageBody}</p>
                <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2">
                  {linuxArchs.map((arch) => (
                    <a href={linux[arch].url} class="dl-button" data-linux-arch={arch} hidden={arch !== "x86_64"}>
                      {c.install.linux.download[arch]}
                    </a>
                  ))}
                  {linuxArchs.map((arch) => (
                    <p class="install-meta" data-linux-other={arch} hidden={arch === "x86_64"}>
                      {c.install.other}<a href={linux[arch].url}>{c.install.linux.otherLink[arch]}</a>
                    </p>
                  ))}
                </div>
                {liteVersion && linuxArchs.some((arch) => linux[arch].sha) && (
                  <p class="install-meta">
                    {c.install.version} {liteVersion}
                    {linuxArchs.map((arch) =>
                      linux[arch].sha && <Fragment>{" · "}<a href={linux[arch].sha}>{c.install.sha} ({arch})</a></Fragment>,
                    )}
                  </p>
                )}
              </div>
            </div>
            <p class="install-note">{c.install.linux.note}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16 sm:pb-20 lg:pb-[88px]">
      <div class="container-page">
        <div class="flex flex-col gap-4 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-10">
          <div class="flex flex-col gap-1.5">
            <h2 class="m-0 text-xl font-semibold sm:text-[22px]">{c.license.title}</h2>
            <p class="m-0 text-base text-[var(--color-muted)] sm:text-[17px]">{c.license.body}</p>
          </div>
          <a href={repo} target="_blank" rel="noopener" class:list={[textLink, "shrink-0"]}>
            {c.license.link}
            <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<!--
  Which system's tab is open. Windows visitors get Windows, Linux visitors
  Linux, everyone else macOS. Without script there are no tabs and all three
  panels show. The architecture comes from User-Agent Client Hints, or for
  Linux without them (Firefox) from the User-Agent string: arm with 64-bit picks
  ARM64 / aarch64, and every other answer, a failure or a browser without the
  API picks x64 / x86_64, which is also what the page shows without script.
  Android also says "Linux" and is left out.
-->
<script is:inline data-lite-download>
  (() => {
    const root = document.getElementById("install");
    const tabs = root && root.querySelector("[data-install-tabs]");
    if (!tabs) return;
    const ua = navigator.userAgentData;
    const s = navigator.userAgent;
    const windows = (ua && ua.platform === "Windows") || /Windows NT/.test(s);
    const linux = !windows && !/Android/.test(s) && ((ua && ua.platform === "Linux") || /Linux/.test(s));
    const select = (os) => {
      root.dataset.os = os;
      for (const b of tabs.querySelectorAll("[data-tab]")) {
        const on = b.dataset.tab === os;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      }
      for (const p of root.querySelectorAll("[data-panel]")) p.hidden = p.dataset.panel !== os;
    };
    tabs.hidden = false;
    select(windows ? "windows" : linux ? "linux" : "mac");
    tabs.addEventListener("click", (e) => {
      const b = e.target.closest("[data-tab]");
      if (b) select(b.dataset.tab);
    });
    tabs.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const all = [...tabs.querySelectorAll("[data-tab]")];
      const i = all.findIndex((b) => b.getAttribute("aria-selected") === "true");
      const next = all[(i + (e.key === "ArrowRight" ? 1 : all.length - 1)) % all.length];
      select(next.dataset.tab);
      next.focus();
    });
    const show = (key, arch) => {
      for (const el of root.querySelectorAll(`[data-${key}-arch]`)) el.hidden = el.getAttribute(`data-${key}-arch`) !== arch;
      for (const el of root.querySelectorAll(`[data-${key}-other]`)) el.hidden = el.getAttribute(`data-${key}-other`) === arch;
    };
    const apply = (arm) => {
      show("win", arm && windows ? "arm64" : "x64");
      show("linux", arm && linux ? "aarch64" : "x86_64");
    };
    const guess = linux && /aarch64|arm64/.test(s);
    apply(guess);
    if (!(windows || linux) || !ua || typeof ua.getHighEntropyValues !== "function") return;
    ua.getHighEntropyValues(["architecture", "bitness"]).then(
      (v) => apply(v.architecture === "arm" && v.bitness === "64"),
      () => apply(guess),
    );
  })();
</script>

<script is:inline data-copy-cmd>
  for (const btn of document.querySelectorAll("#install [data-copy]")) {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
      } catch {
        // No clipboard access: select the command so it can be copied by hand.
        getSelection().selectAllChildren(btn.parentElement.querySelector("[data-cmd]"));
        return;
      }
      btn.textContent = btn.dataset.copiedLabel;
      setTimeout(() => (btn.textContent = label), 1500);
    });
  }
</script>

