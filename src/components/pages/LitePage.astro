---
// The /lite product page: ThinkWatch Lite, the desktop app for individual
// developers on macOS, Windows and Linux. Status copy must stay in line with the Lite
// README.
//
// Each page shows the interface in its own language: the app ships in both,
// and a screenshot of the other one says little to the reader.
import LiteDownload from "~/components/LiteDownload.astro";
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { getLang, localePath, t } from "~/i18n";
import { liteCopy } from "~/i18n/pages/lite";
import { getLatestLiteRelease } from "~/lib/github";

const lang = getLang(Astro);
const c = liteCopy[lang];
const ui = t(lang).common;
const zh = lang === "zh-CN";
/** 英文界面的那一套图带 `-en`，见文件头 */
const shot = (id: string) => `/lite/${id}${zh ? "" : "-en"}.webp`;

const repo = "https://github.com/ThinkWatchProject/ThinkWatch-Lite";
const releases = `${repo}/releases`;
const latestPage = `${releases}/latest`;

// Windows installers of the latest release. The file names carry the version,
// so they come from the release's asset list, looked up at build time; without
// it, the buttons lead to the latest release page instead.
const liteRelease = await getLatestLiteRelease();
const assetUrl = (suffix: string) => {
  const name = Object.keys(liteRelease?.assets ?? {}).find((n) => n.endsWith(suffix));
  return name ? liteRelease!.assets[name] : null;
};
const winArchs = ["x64", "arm64"] as const;
const win = Object.fromEntries(
  winArchs.map((arch) => [
    arch,
    { url: assetUrl(`-${arch}-setup.exe`) ?? latestPage, sha: assetUrl(`-${arch}-setup.exe.sha256`) },
  ]),
) as Record<(typeof winArchs)[number], { url: string; sha: string | null }>;
const linuxArchs = ["x86_64", "aarch64"] as const;
const linux = Object.fromEntries(
  linuxArchs.map((arch) => [
    arch,
    { url: assetUrl(`-${arch}.AppImage`) ?? latestPage, sha: assetUrl(`-${arch}.AppImage.sha256`) },
  ]),
) as Record<(typeof linuxArchs)[number], { url: string; sha: string | null }>;
const installScript = `${latestPage}/download/install.sh`;
const dmg = { url: assetUrl("-arm64.dmg") ?? latestPage, sha: assetUrl("-arm64.dmg.sha256") };
const liteVersion = liteRelease?.tag.replace(/^v/, "") ?? null;
const installDocsHref = localePath(lang, "/docs/lite/install");
const sourceDocsHref = localePath(lang, "/docs/lite/run-from-source");
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "ThinkWatch Lite",
    description: c.meta.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem:
      "macOS 12 or later (Apple Silicon); Windows 10 21H2 or later (x64, ARM64); Linux: Ubuntu 22.04, Debian 12, Fedora 36 or later (x86_64, aarch64)",
    url: pageUrl,
    downloadUrl: latestPage,
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
    author: {
      "@type": "Organization",
      name: "ThinkWatch Project",
      url: "https://github.com/ThinkWatchProject",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "ThinkWatch Lite",
    description: c.meta.description,
    codeRepository: repo,
    programmingLanguage: ["TypeScript", "Rust"],
    license: "https://opensource.org/licenses/MIT",
    url: pageUrl,
  },
];

const delay = (i: number) => `animation-delay: ${i * 90}ms;`;
const eyebrow = "font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted)] sm:text-[13px]";
const h2 = zh
  ? "font-display m-0 text-[26px] leading-[1.35] sm:text-[32px] lg:text-[36px]"
  : "font-display m-0 text-[30px] leading-[1.15] sm:text-[36px] lg:text-[40px]";
const textLink =
  "inline-flex min-h-11 items-center text-[17px] font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]";
const nodes = [c.built.lite, c.built.core, c.built.upstreams];
/** 截图外的一圈：和窗口自带的阴影配合，不再加边框 */
const shotClass = "w-full rounded-[10px]";
const platformLabel = "m-0 font-mono text-[13px] text-[var(--color-muted)]";
const archLabel = { x64: "x64", arm64: "ARM64" } as const;
---

<Base title={c.meta.title} description={c.meta.description} noJsonLd jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="relative overflow-hidden">
      <div class="container-page grid items-center gap-12 pb-12 pt-14 sm:pb-16 sm:pt-20 lg:grid-cols-2 lg:gap-16 lg:pb-[72px] lg:pt-[88px]">
        <div class="flex min-w-0 flex-col gap-5 sm:gap-6">
          <p class="reveal m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-brand-1)] sm:text-[13px]" style={delay(0)}>
            {c.hero.eyebrow}
          </p>
          <h1
            class:list={[
              "reveal font-display m-0 text-[var(--color-text)]",
              zh
                ? "text-[30px] leading-[1.35] sm:text-[40px] lg:text-[48px]"
                : "text-[36px] leading-[1.1] sm:text-[46px] lg:text-[56px] lg:leading-[1.05]",
            ]}
            style={delay(1)}
          >
            {c.hero.titleA}<span class="text-shimmer">{c.hero.titleHighlight}</span>
          </h1>
          <p class="reveal m-0 max-w-[36rem] text-[17px] leading-relaxed text-[#cbd5e1] sm:text-xl sm:leading-normal" style={delay(2)}>
            {c.hero.sub}
          </p>
          <div class="reveal mt-1 flex flex-col gap-3 sm:mt-2 sm:flex-row sm:items-start sm:gap-5" style={delay(3)}>
            {/* 直接下载这台机器要的那个文件；认不出、或者没有对应的包时去安装一节 */}
            <LiteDownload />
            <a
              href="#install"
              class="inline-flex min-h-11 items-center justify-center text-base font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)] sm:justify-start"
            >
              {c.hero.ctaSecondary}
            </a>
          </div>
        </div>
        <div class="reveal min-w-0" style={delay(3)}>
          <img
            src={shot("overview")}
            width="2360"
            height="1540"
            class={shotClass}
            fetchpriority="high"
            alt={c.hero.shotAlt}
          />
        </div>
      </div>
    </section>

    <div class="container-page">
      <div
        class="reveal flex flex-col items-start gap-3 rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-5 sm:flex-row sm:items-center sm:gap-7 sm:px-7 sm:py-6"
        style={delay(5)}
      >
        <span class="shrink-0 rounded-full bg-[var(--color-brand-1)] px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.06em] text-[var(--color-bg)]">
          {c.status.badge}
        </span>
        <p class="m-0 text-base leading-relaxed text-[#cbd5e1] sm:text-[17px]">{c.status.body}</p>
      </div>
    </div>

    <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="lite-shows">
      <div class="container-page">
        <h2 id="lite-shows" class:list={[eyebrow, "m-0 font-normal"]}>{c.features.eyebrow}</h2>
        <div class="mt-8 flex flex-col gap-14 sm:gap-20">
          {c.features.items.map((item, i) => (
            <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-14">
              <div class:list={["flex min-w-0 flex-col gap-3", i % 2 === 1 && "lg:order-2"]}>
                <h3 class="m-0 text-xl font-semibold leading-snug tracking-tight sm:text-2xl">{item.title}</h3>
                <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{item.body}</p>
              </div>
              <img
                src={shot(item.id)}
                width="2360"
                height="1540"
                loading="lazy"
                decoding="async"
                class={shotClass}
                alt={item.title}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-16 sm:pb-20 lg:pb-24" aria-labelledby="lite-menubar">
      <div class="container-page grid items-center gap-8 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14">
        <div class="flex flex-col gap-3">
          <p class:list={[eyebrow, "m-0"]}>{c.menubar.eyebrow}</p>
          <h2 id="lite-menubar" class={h2}>{c.menubar.title}</h2>
          <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{c.menubar.body}</p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <img src="/lite/menubar-cost.png" width="420" height="64" loading="lazy" class="h-auto w-[420px] max-w-full" alt={c.menubar.costAlt} />
          <img src="/lite/menubar-quota.png" width="420" height="64" loading="lazy" class="h-auto w-[420px] max-w-full" alt={c.menubar.quotaAlt} />
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-surface)] py-16 sm:py-20 lg:py-[88px]" aria-labelledby="lite-built">
      <div class="container-page">
        <h2 id="lite-built" class:list={[eyebrow, "m-0 font-normal"]}>{c.built.eyebrow}</h2>
        <div class="mt-8 grid items-stretch lg:mt-10 lg:grid-cols-[minmax(0,1fr)_120px_minmax(0,1fr)_120px_minmax(0,1fr)] lg:items-center">
          {nodes.map((node, i) => (
            <Fragment>
              {i > 0 && (
                <div
                  class="flow-link relative flex items-center justify-center py-2 lg:py-0"
                  data-active={i === 1 ? "true" : undefined}
                  aria-hidden={i === 1 ? undefined : "true"}
                >
                  <div
                    class:list={[
                      "flow-line relative h-10 w-px lg:h-px lg:w-full",
                      i === 1 ? "bg-[var(--color-brand-1)]" : "bg-[var(--color-border-strong)]",
                    ]}
                  >
                    {i === 1 && <span class="flow-dot" aria-hidden="true"></span>}
                  </div>
                  {i === 1 && (
                    <span class="absolute left-[calc(50%+14px)] font-mono text-xs text-[var(--color-muted)] lg:left-auto lg:top-[calc(50%+8px)]">
                      {c.built.link}
                    </span>
                  )}
                </div>
              )}
              <div
                class:list={[
                  "flex flex-col gap-2.5 rounded-[14px] border bg-[var(--color-bg)]/30 p-6 sm:p-7",
                  i === 0 ? "border-[var(--color-brand-1)]" : "border-[var(--color-border-strong)]",
                ]}
              >
                <h3 class="m-0 text-xl font-semibold sm:text-[22px]">{node.title}</h3>
                <p class="m-0 text-[15px] leading-normal text-[var(--color-muted)]">{node.body}</p>
              </div>
            </Fragment>
          ))}
        </div>
      </div>
    </section>

    <section id="install" data-os="other" class="scroll-mt-20 py-16 sm:py-20 lg:py-[88px]">
      <div class="container-page grid items-start gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="flex min-w-0 flex-col gap-4">
          <p class:list={[eyebrow, "m-0"]}>{c.install.eyebrow}</p>
          <h2 class={h2}>{c.install.title}</h2>
          <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{c.install.brewNote}</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href={installDocsHref} class={textLink}>{c.install.docs}</a>
            <a href={sourceDocsHref} class={textLink}>{c.install.source}</a>
          </div>
        </div>
        <div class="flex min-w-0 flex-col gap-8" data-install-list>
          <div class="flex min-w-0 flex-col gap-4" data-install-os="mac">
            <p class={platformLabel}>{c.install.macLabel}</p>
            <div class="flex items-center rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] font-mono text-[15px] leading-relaxed sm:text-base">
              <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap p-5 text-[#e6ebf2] sm:p-7">
                <span class="select-none text-[var(--color-dim)]">$ </span><span data-cmd>brew install --cask thinkwatchproject/tap/thinkwatch-lite</span>
              </code>
              <button type="button" class="copy-cmd" data-copy="brew install --cask thinkwatchproject/tap/thinkwatch-lite" data-copied-label={ui.copied}>{ui.copy}</button>
            </div>
            <div class="flex flex-col gap-2 rounded-[14px] border border-[var(--color-border-strong)] p-5 sm:p-7">
              <h3 class="m-0 text-lg font-semibold sm:text-xl">{c.install.dmgTitle}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">{c.install.dmgBody}</p>
              <a href={dmg.url} class="dl-button self-start">{c.install.dmgDownload}</a>
              {liteVersion && dmg.sha && (
                <p class="m-0 font-mono text-[13px] text-[var(--color-muted)]">
                  {c.install.version} {liteVersion}
                  {" · "}
                  <a href={dmg.sha} class="text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]">sha256</a>
                </p>
              )}
              <a href={releases} target="_blank" rel="noopener" class:list={[textLink, "self-start"]}>
                {c.install.releases}
                <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </div>
          <div class="flex min-w-0 flex-col gap-4" data-install-os="windows">
            <p class={platformLabel}>{c.install.winLabel}</p>
            <div class="flex flex-col gap-4 rounded-[14px] border border-[var(--color-border-strong)] p-5 sm:p-7">
              <h3 class="m-0 text-lg font-semibold sm:text-xl">{c.install.winTitle}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">{c.install.winBody}</p>
              <div class="flex flex-col items-start gap-2">
                {winArchs.map((arch) => (
                  <a href={win[arch].url} class="win-download" data-win-arch={arch} hidden={arch !== "x64"}>
                    {c.install.winDownload[arch]}
                  </a>
                ))}
                {winArchs.map((arch) => (
                  <p class="m-0 text-[15px] text-[var(--color-muted)]" data-win-other={arch} hidden={arch === "x64"}>
                    {c.install.winOther}<a href={win[arch].url} class="font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]">
                      {c.install.winOtherLink[arch]}
                    </a>
                  </p>
                ))}
              </div>
              {liteVersion && (
                <p class="m-0 font-mono text-[13px] text-[var(--color-muted)]">
                  {c.install.version} {liteVersion}
                  {winArchs.map((arch) =>
                    win[arch].sha && (
                      <Fragment>
                        {" · "}
                        <a href={win[arch].sha} class="text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]">
                          sha256 ({archLabel[arch]})
                        </a>
                      </Fragment>
                    ),
                  )}
                </p>
              )}
              <p class="m-0 border-t border-[var(--color-border-strong)] pt-4 text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">
                {c.install.winUnsigned}
              </p>
            </div>
          </div>
          <div class="flex min-w-0 flex-col gap-4" data-install-os="linux">
            <p class={platformLabel}>{c.install.linuxLabel}</p>
            <div class="flex items-center rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] font-mono text-[15px] leading-relaxed sm:text-base">
              <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap p-5 text-[#e6ebf2] sm:p-7">
                <span class="select-none text-[var(--color-dim)]">$ </span><span data-cmd>curl -fsSL {installScript} | sh</span>
              </code>
              <button type="button" class="copy-cmd" data-copy={`curl -fsSL ${installScript} | sh`} data-copied-label={ui.copied}>{ui.copy}</button>
            </div>
            <p class="m-0 text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">{c.install.linuxScript}</p>
            <div class="flex flex-col gap-4 rounded-[14px] border border-[var(--color-border-strong)] p-5 sm:p-7">
              <h3 class="m-0 text-lg font-semibold sm:text-xl">{c.install.linuxTitle}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">{c.install.linuxBody}</p>
              <div class="flex flex-col items-start gap-2">
                {linuxArchs.map((arch) => (
                  <a href={linux[arch].url} class="dl-button" data-linux-arch={arch} hidden={arch !== "x86_64"}>
                    {c.install.linuxDownload[arch]}
                  </a>
                ))}
                {linuxArchs.map((arch) => (
                  <p class="m-0 text-[15px] text-[var(--color-muted)]" data-linux-other={arch} hidden={arch === "x86_64"}>
                    {c.install.linuxOther}<a href={linux[arch].url} class="font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]">
                      {c.install.linuxOtherLink[arch]}
                    </a>
                  </p>
                ))}
              </div>
              {liteVersion && linuxArchs.some((arch) => linux[arch].sha) && (
                <p class="m-0 font-mono text-[13px] text-[var(--color-muted)]">
                  {c.install.version} {liteVersion}
                  {linuxArchs.map((arch) =>
                    linux[arch].sha && (
                      <Fragment>
                        {" · "}
                        <a href={linux[arch].sha} class="text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]">
                          sha256 ({arch})
                        </a>
                      </Fragment>
                    ),
                  )}
                </p>
              )}
              <p class="m-0 border-t border-[var(--color-border-strong)] pt-4 text-[15px] leading-relaxed text-[var(--color-muted)] sm:text-base">
                {c.install.linuxNotes}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-16 sm:pb-20 lg:pb-[88px]">
      <div class="container-page">
        <div class="flex flex-col gap-4 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-10">
          <div class="flex flex-col gap-1.5">
            <h2 class="m-0 text-xl font-semibold sm:text-[22px]">{c.license.title}</h2>
            <p class="m-0 text-base text-[var(--color-muted)] sm:text-[17px]">{c.license.body}</p>
          </div>
          <a href={repo} target="_blank" rel="noopener" class:list={[textLink, "shrink-0"]}>
            {c.license.link}
            <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<!--
  Which installer to put first. Windows visitors get the Windows block on top
  with the button filled, Linux visitors the Linux block; everyone else keeps
  macOS on top. The architecture comes from User-Agent Client Hints, or for
  Linux without them (Firefox) from the User-Agent string: arm with 64-bit picks
  ARM64 / aarch64, and every other answer, a failure or a browser without the
  API picks x64 / x86_64, which is also what the page shows without script.
  Android also says "Linux" and is left out.
-->
<script is:inline data-lite-download>
  (() => {
    const root = document.getElementById("install");
    const list = root && root.querySelector("[data-install-list]");
    if (!list) return;
    const ua = navigator.userAgentData;
    const s = navigator.userAgent;
    const windows = (ua && ua.platform === "Windows") || /Windows NT/.test(s);
    const linux = !windows && !/Android/.test(s) && ((ua && ua.platform === "Linux") || /Linux/.test(s));
    const os = windows ? "windows" : linux ? "linux" : "other";
    const show = (arm) => {
      const [key, arch] = linux ? ["linux", arm ? "aarch64" : "x86_64"] : ["win", arm ? "arm64" : "x64"];
      for (const el of root.querySelectorAll(`[data-${key}-arch]`)) el.hidden = el.getAttribute(`data-${key}-arch`) !== arch;
      for (const el of root.querySelectorAll(`[data-${key}-other]`)) el.hidden = el.getAttribute(`data-${key}-other`) === arch;
    };
    root.dataset.os = os;
    list.prepend(list.querySelector(`[data-install-os="${windows ? "windows" : linux ? "linux" : "mac"}"]`));
    if (!windows && !linux) return;
    const guess = linux && /aarch64|arm64/.test(s);
    show(guess);
    if (!ua || typeof ua.getHighEntropyValues !== "function") return;
    ua.getHighEntropyValues(["architecture", "bitness"]).then(
      (v) => show(v.architecture === "arm" && v.bitness === "64"),
      () => show(guess),
    );
  })();
</script>

<script is:inline data-copy-cmd>
  for (const btn of document.querySelectorAll("#install [data-copy]")) {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
      } catch {
        // No clipboard access: select the command so it can be copied by hand.
        getSelection().selectAllChildren(btn.parentElement.querySelector("[data-cmd]"));
        return;
      }
      btn.textContent = btn.dataset.copiedLabel;
      setTimeout(() => (btn.textContent = label), 1500);
    });
  }
</script>

<style>
  /* Copy button beside an install command; the command scrolls, the button stays. */
  .copy-cmd {
    flex-shrink: 0;
    align-self: stretch;
    border-left: 1px solid var(--color-border-strong);
    padding: 0 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: color 150ms;
  }
  .copy-cmd:hover {
    color: var(--color-brand-1);
  }

  /* Download buttons. Outlined by default; the Windows one is filled for Windows
     visitors, whose installer that is. The disk image stays outlined: on a Mac
     the Homebrew command above it is the first choice. */
  .dl-button,
  .win-download {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid var(--color-brand-1);
    padding: 0.625rem 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-brand-1);
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
