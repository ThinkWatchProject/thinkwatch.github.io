---
import { getLang } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";

const c = homeCopy[getLang(Astro)];
const clients = ["Claude Code", "Codex", "Cursor", "Continue", "Cline", "OpenAI SDK", "Anthropic SDK", "Gemini SDK", "opencode", "Zed"];
---

<section class="wall" aria-label={c.wallLabel}>
  <p class="nx-label wall-label">{c.wallLabel}</p>
  <div class="nx-marquee">
    <ul class="nx-track">
      {[...clients, ...clients].map((name, i) => <li aria-hidden={i >= clients.length ? "true" : undefined}>{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .wall {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 32px 0;
  }
  .wall-label {
    margin: 0 0 18px;
    text-align: center;
  }
</style>
