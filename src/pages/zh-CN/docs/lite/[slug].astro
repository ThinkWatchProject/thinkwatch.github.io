---
import DocArticle from "~/pages/docs/_DocArticle.astro";
import { getArticlePaths } from "~/pages/docs/_lib";

export async function getStaticPaths() {
  return getArticlePaths("lite", "zh-CN");
}

const { entry, slug } = Astro.props;
---

<DocArticle lang="zh-CN" product="lite" slug={slug} entry={entry} />
