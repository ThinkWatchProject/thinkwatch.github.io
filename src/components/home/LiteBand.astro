---
// The Lite band on the home page: the local gateway, its four points, where it
// runs, and a download, beside its overview screen. Each page shows the
// interface in its own language; see LitePage.astro.
import { getLang, localePath } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";
import LiteDownload from "~/components/LiteDownload.astro";
import TwMark from "~/components/TwMark.astro";

const lang = getLang(Astro);
const c = homeCopy[lang].lite;
const zh = lang === "zh-CN";
---

<section class="nx-section nx-hairline lite-band">
  <div class="glow" aria-hidden="true"></div>
  <div class="container-page grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
    <div class="min-w-0">
      <p class="nx-label nx-in flex items-center gap-2"><TwMark id="m-liteband" size={18} />{c.eyebrow}</p>
      <h2 class="nx-h2 nx-in mt-3">{c.title}</h2>
      <div class="points">
        {c.points.map((p) => (
          <div class="nx-in">
            <h3 class="nx-h3">{p.t}</h3>
            <p class="nx-body">{p.b}</p>
          </div>
        ))}
      </div>
      <div class="pills nx-in">
        <span class="badge">{c.pills[0]}</span>
        {c.pills.slice(1).map((pill) => <span class="pill">{pill}</span>)}
      </div>
      <div class="nx-actions nx-in">
        <LiteDownload />
        <a href={localePath(lang, "/lite")} class="nx-link">{c.cta}</a>
      </div>
    </div>
    <div class="shot nx-in">
      <img
        src={zh ? "/lite/overview.webp" : "/lite/overview-en.webp"}
        width="2360"
        height="1540"
        loading="lazy"
        decoding="async"
        alt={c.shotAlt}
      />
    </div>
  </div>
</section>

<style>
  .lite-band {
    position: relative;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    right: -10%;
    top: 20%;
    width: 60%;
    height: 70%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--a2) / 0.14), rgb(var(--a1) / 0.06) 60%, transparent);
    filter: blur(30px);
  }
  .points {
    margin-top: 32px;
    display: grid;
    gap: 22px 32px;
  }
  @media (min-width: 640px) {
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pills {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .badge {
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(var(--a1)), rgb(var(--a2)));
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 600;
    color: #08090a;
  }
  .pill {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 3px 12px;
    font-size: 12px;
    color: #c3c7ce;
  }
  .shot {
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.14),
      0 50px 120px -40px rgba(0, 0, 0, 0.9),
      0 30px 100px -40px rgb(var(--a1) / 0.35);
    overflow: hidden;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot:hover {
    transform: translateY(-6px);
  }
</style>
