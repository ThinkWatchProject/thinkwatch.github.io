---
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { t } from "~/i18n";

// GitHub Pages serves one static 404 for every language, so both copies are
// rendered and the inline script below shows the one the visitor prefers.
const en = t("en").notFound;
const zh = t("zh-CN").notFound;

// `path` is the English path; the script prefixes /zh-CN for Chinese visitors.
const links = [
  { path: "/", en: en.home, zh: zh.home, primary: true },
  { path: "/lite", en: en.lite, zh: zh.lite, primary: false },
  { path: "/thinkwatch", en: en.thinkwatch, zh: zh.thinkwatch, primary: false },
  { path: "/core", en: en.core, zh: zh.core, primary: false },
  { path: "/docs", en: en.docs, zh: zh.docs, primary: false },
];
---

<Base title={en.title} description={en.description} noindex>
  <SiteHeader />
  <main id="main">
    <section class="nx-hero nf-hero">
      <div class="nx-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="nx-gridbg" aria-hidden="true"></div>
      <div class="container-page nf-grid">
        <div class="min-w-0">
          <p class="nf-code nx-grad nx-rise" aria-hidden="true">404</p>
          <h1 class="nx-h2 nf-h1 nx-rise" style="--d:1">
            <span data-i18n="en">{en.headline}</span>
            <span data-i18n="zh-CN" hidden>{zh.headline}</span>
          </h1>
          <p class="nx-sub nx-rise" style="--d:2">
            <span data-i18n="en">{en.sub}</span>
            <span data-i18n="zh-CN" hidden>{zh.sub}</span>
          </p>

          <nav class="nx-rise" style="--d:3">
            <h2 class="sr-only">
              <span data-i18n="en">{en.linksLabel}</span>
              <span data-i18n="zh-CN" hidden>{zh.linksLabel}</span>
            </h2>
            <ul class="nf-links">
              {links.map((l) => (
                <li>
                  <a href={l.path} data-localize={l.path} class={l.primary ? "nx-pill" : "nx-ghost"}>
                    <span data-i18n="en">{l.en}</span>
                    <span data-i18n="zh-CN" hidden>{l.zh}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        <!-- A real request for the missing path; the script fills in the path the visitor asked for. -->
        <figure class="nx-panel nf-term nx-rise" style="--d:3" aria-hidden="true">
          <div class="nx-panel-top">
            <span class="nx-lights"><i></i><i></i><i></i></span>
            <span>zsh</span>
          </div>
          <pre><span class="nf-prompt">$</span> curl -I https://thinkwat.ch<span data-request-path>{Astro.url.pathname}</span>
<span class="nf-status">HTTP/2 404</span>
<span class="nf-dim">server: GitHub.com
content-type: text/html; charset=utf-8</span>
<span class="nf-prompt">$</span> <span class="nf-caret"></span></pre>
        </figure>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .nf-hero {
    padding: 72px 0 104px;
  }
  .nf-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .nf-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 56px;
    }
  }
  .nf-code {
    margin: 0;
    font-size: clamp(96px, 14vw, 176px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }
  .nf-h1 {
    margin-top: 24px;
  }
  .nf-links {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .nf-term pre {
    margin: 0;
    overflow-x: auto;
    padding: 22px 22px 26px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--color-text);
    white-space: pre;
  }
  .nf-prompt {
    color: rgb(var(--a1));
  }
  .nf-status {
    color: rgb(var(--a2));
    font-weight: 600;
  }
  .nf-dim {
    color: var(--color-dim);
  }
  .nf-caret {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--color-text);
    animation: nx-blink 1.1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-caret {
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ enTitle: en.title, zhTitle: zh.title }}>
  (function () {
    try {
      // Show the path that was actually requested, not the build-time /404.
      var pathEl = document.querySelector("[data-request-path]");
      if (pathEl) pathEl.textContent = location.pathname;

      var stored = localStorage.getItem("tw-lang-pref");
      var pref = (stored === "en" || stored === "zh-CN")
        ? stored
        : ((navigator.language || "en").toLowerCase().indexOf("zh") === 0 ? "zh-CN" : "en");

      // Toggle visible spans
      document.querySelectorAll("[data-i18n]").forEach(function (el) {
        el.hidden = el.getAttribute("data-i18n") !== pref;
      });

      // Update <html lang> and <title>
      document.documentElement.lang = pref;
      document.title = pref === "zh-CN" ? zhTitle : enTitle;

      // Point every link at the Chinese site for Chinese visitors
      if (pref === "zh-CN") {
        document.querySelectorAll("[data-localize]").forEach(function (a) {
          var path = a.getAttribute("data-localize") || "/";
          a.setAttribute("href", path === "/" ? "/zh-CN/" : "/zh-CN" + path);
        });
      }
    } catch (e) {}
  })();
</script>
