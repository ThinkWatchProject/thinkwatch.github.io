<!--
  Motion on this page. The hero plays three requests through the gateway; the
  story picks its screenshot by the step at the middle of the screen and fills
  a rail; tiles light up under the pointer; a few figures tick up. Blocks move
  into place as they come into view, and only their position moves, so the page
  reads the same without script. With reduced motion, nothing moves.
-->
<script is:inline data-lite-motion>
  (() => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const flow = document.querySelector("[data-flow]");
    const json = document.querySelector("[data-scenes-json]");
    if (flow && json && !reduce) {
      const scenes = JSON.parse(json.textContent);
      // Which client and upstream each scene lights; the second fails over.
      const cast = [
        { client: 0, up: ["on", "", ""], warn: 0, bad: 0 },
        { client: 1, up: ["", "fail", "on"], warn: 2, bad: 0 },
        { client: 2, up: ["", "", "on"], warn: 0, bad: 3 },
      ];
      const clients = [...flow.querySelectorAll("[data-clients] .node")];
      const ups = [...flow.querySelectorAll("[data-upstreams] .node")];
      const checks = [...flow.querySelectorAll("[data-checks] li")];
      const lines = [...flow.querySelectorAll("[data-log] li")];
      const dots = [...flow.querySelectorAll("[data-scenes] i")];
      let s = 0;
      let step = -1;
      const load = (k) => {
        const sc = scenes[k];
        const c = cast[k];
        clients.forEach((n, i) => n.classList.toggle("on", i === c.client));
        ups.forEach((n, i) => (n.dataset.state = c.up[i]));
        checks.forEach((li, i) => {
          li.querySelector("b").textContent = sc.checks[i][0];
          li.querySelector("span").textContent = sc.checks[i][1];
          li.classList.toggle("warn", c.warn === i + 1);
          li.classList.toggle("bad", c.bad === i + 1);
        });
        lines.forEach((li, i) => (li.innerHTML = sc.log[i]));
        dots.forEach((d, i) => d.toggleAttribute("data-on", i === k));
      };
      const paint = () => {
        [...checks, ...lines].forEach((el) => el.toggleAttribute("data-on", Number(el.dataset.step) <= step));
        ups.forEach((n) => {
          const st = n.dataset.state || "";
          n.classList.toggle("fail", st === "fail" && step >= 2);
          n.classList.toggle("on", st === "on" && step >= (cast[s].warn ? 2 : 1));
        });
        flow.toggleAttribute("data-running", step >= 0 && step <= 4);
      };
      load(0);
      paint();
      setInterval(() => {
        if (document.hidden) return;
        step++;
        if (step > 6) {
          s = (s + 1) % scenes.length;
          load(s);
          step = -1;
        }
        paint();
      }, 850);
    }

    const story = document.querySelector("[data-story]");
    if (story) {
      const steps = [...story.querySelectorAll("[data-step-id]")];
      const shots = [...story.querySelectorAll("[data-shot]")];
      const rail = story.querySelector("[data-rail]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const id = e.target.dataset.stepId;
            steps.forEach((x) => x.toggleAttribute("data-active", x === e.target));
            shots.forEach((x) => x.toggleAttribute("data-active", x.dataset.shot === id));
          }
        },
        { rootMargin: "-45% 0px -45% 0px" },
      );
      steps.forEach((x) => io.observe(x));
      const fill = () => {
        const first = steps[0].getBoundingClientRect();
        const last = steps[steps.length - 1].getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight / 2 - first.top) / (last.bottom - first.top)));
        rail.style.transform = `scaleY(${p})`;
      };
      addEventListener("scroll", fill, { passive: true });
      fill();
      const tilt = story.querySelector("[data-tilt]");
      if (tilt && !reduce) {
        tilt.addEventListener("pointermove", (e) => {
          const r = tilt.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = `perspective(1400px) rotateY(${x * 4}deg) rotateX(${-y * 4}deg)`;
        });
        tilt.addEventListener("pointerleave", () => (tilt.style.transform = ""));
      }
    }

    document.querySelectorAll(".tile").forEach((t) => {
      t.addEventListener("pointermove", (e) => {
        const r = t.getBoundingClientRect();
        t.style.setProperty("--mx", `${e.clientX - r.left}px`);
        t.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });

    if (reduce) return;

    document.documentElement.classList.add("lp-motion");
    const rio = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.setAttribute("data-in", "");
          rio.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    document.querySelectorAll(".lp-in").forEach((el) => rio.observe(el));

    const counters = [...document.querySelectorAll("[data-count]")];
    setInterval(() => {
      if (document.hidden) return;
      counters.forEach((el) => {
        if (Math.random() < 0.55) return;
        const v = parseFloat(el.dataset.count) + parseFloat(el.dataset.step) * (0.5 + Math.random());
        el.dataset.count = String(v);
        el.textContent = (el.dataset.prefix || "") + v.toFixed(Number(el.dataset.fixed || 1)) + (el.dataset.unit || "");
        el.classList.remove("tick");
        void el.offsetWidth;
        el.classList.add("tick");
      });
    }, 1400);
  })();
</script>

<!--
  Which system's tab is open. Windows visitors get Windows, Linux visitors
  Linux, everyone else macOS. Without script there are no tabs and all three
  panels show. The architecture comes from User-Agent Client Hints, or for
  Linux without them (Firefox) from the User-Agent string: arm with 64-bit picks
  ARM64 / aarch64, and every other answer, a failure or a browser without the
  API picks x64 / x86_64, which is also what the page shows without script.
  Android also says "Linux" and is left out.
-->
<script is:inline data-lite-download>
  (() => {
    const root = document.getElementById("install");
    const tabs = root && root.querySelector("[data-install-tabs]");
    if (!tabs) return;
    const ua = navigator.userAgentData;
    const s = navigator.userAgent;
    const windows = (ua && ua.platform === "Windows") || /Windows NT/.test(s);
    const linux = !windows && !/Android/.test(s) && ((ua && ua.platform === "Linux") || /Linux/.test(s));
    const select = (os) => {
      root.dataset.os = os;
      for (const b of tabs.querySelectorAll("[data-tab]")) {
        const on = b.dataset.tab === os;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      }
      for (const p of root.querySelectorAll("[data-panel]")) p.hidden = p.dataset.panel !== os;
    };
    tabs.hidden = false;
    select(windows ? "windows" : linux ? "linux" : "mac");
    tabs.addEventListener("click", (e) => {
      const b = e.target.closest("[data-tab]");
      if (b) select(b.dataset.tab);
    });
    tabs.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const all = [...tabs.querySelectorAll("[data-tab]")];
      const i = all.findIndex((b) => b.getAttribute("aria-selected") === "true");
      const next = all[(i + (e.key === "ArrowRight" ? 1 : all.length - 1)) % all.length];
      select(next.dataset.tab);
      next.focus();
    });
    const show = (key, arch) => {
      for (const el of root.querySelectorAll(`[data-${key}-arch]`)) el.hidden = el.getAttribute(`data-${key}-arch`) !== arch;
      for (const el of root.querySelectorAll(`[data-${key}-other]`)) el.hidden = el.getAttribute(`data-${key}-other`) === arch;
    };
    const apply = (arm) => {
      show("win", arm && windows ? "arm64" : "x64");
      show("winzip", arm && windows ? "arm64" : "x64");
      show("linux", arm && linux ? "aarch64" : "x86_64");
    };
    const guess = linux && /aarch64|arm64/.test(s);
    apply(guess);
    if (!(windows || linux) || !ua || typeof ua.getHighEntropyValues !== "function") return;
    ua.getHighEntropyValues(["architecture", "bitness"]).then(
      (v) => apply(v.architecture === "arm" && v.bitness === "64"),
      () => apply(guess),
    );
  })();
</script>

<script is:inline data-copy-cmd>
  for (const btn of document.querySelectorAll("#install [data-copy]")) {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
      } catch {
        // No clipboard access: select the command so it can be copied by hand.
        getSelection().selectAllChildren(btn.parentElement.querySelector("[data-cmd]"));
        return;
      }
      btn.textContent = btn.dataset.copiedLabel;
      setTimeout(() => (btn.textContent = label), 1500);
    });
  }
</script>

