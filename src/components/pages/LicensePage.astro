---
// Shared /license page. Copy lives in src/i18n/pages/license.ts.
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import NeonMotion from "~/components/NeonMotion.astro";
import { getLang } from "~/i18n";
import { licenseCopy } from "~/i18n/pages/license";
import { breadcrumbs, webPage } from "~/lib/structured-data";

const lang = getLang(Astro);
const c = licenseCopy[lang];

const jsonLd = [
  webPage(lang, "/license", c.meta.title, c.meta.description),
  breadcrumbs(lang, "/license", c.meta.breadcrumbHome, c.meta.breadcrumbPage),
];
---

<Base title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="nx-hero lic-hero">
      <div class="nx-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="nx-gridbg" aria-hidden="true"></div>
      <div class="container-page">
        <p class="nx-label nx-rise">{c.hero.eyebrow}</p>
        <h1 class="nx-h1 lic-h1 nx-rise" style="--d:1"><span class="nx-grad">{c.hero.title}</span></h1>
        <p class="nx-sub nx-rise" style="--d:2">{c.hero.sub}</p>

        <!-- The three products and their licenses -->
        <div class="lic-products nx-rise" style="--d:3">
          {c.products.map((p) => (
            <div class="nx-tile lic-product">
              <span class:list={["lic-badge", p.tone === "amber" && "lic-badge-bsl"]}>{p.badge}</span>
              <h2 class="lic-name">{p.name}</h2>
              <p class="nx-body">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ThinkWatch Enterprise: BSL rules and commercial tiers -->
    <section class="nx-section nx-hairline">
      <div class="container-page">
        <p class="nx-label nx-in">{c.rules.eyebrow}</p>
        <h2 class="nx-h2 lic-h2 nx-in">{c.rules.title}</h2>

        <dl class="lic-terms nx-in">
          {c.rules.rows.map((r) => (
            <div>
              <dt>{r.term}</dt>
              <dd>{r.rule}</dd>
            </div>
          ))}
        </dl>

        <h3 class="lic-h3 nx-in">{c.tiers.title}</h3>
        <p class="nx-body nx-in">{c.tiers.sub}</p>
        <p class="lic-hint md:hidden">{c.tiers.scrollHint}</p>

        <!-- The table keeps its column widths and scrolls inside this box on narrow screens. -->
        <div class="tier-scroll nx-in" role="region" aria-label={c.tiers.tableLabel} tabindex="0">
          <table>
            <thead>
              <tr>
                {c.tiers.headers.map((h) => <th scope="col">{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {c.tiers.rows.map((row) => (
                <tr class:list={[row.free && "tier-free"]}>
                  <th scope="row">{row.name}</th>
                  <td class="num">{row.tokens}</td>
                  <td class="num">{row.calls}</td>
                  <td class="price">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="lic-notes">
          {c.tiers.notes.map((n) => <p>{n}</p>)}
        </div>
      </div>
    </section>

    <!-- What counts toward the thresholds -->
    <section class="nx-section nx-hairline">
      <div class="container-page">
        <h2 class="nx-h2 lic-h2 nx-in">{c.counts.eyebrow}</h2>
        <p class="nx-sub nx-in">{c.counts.volume}</p>
        <div class="lic-counts">
          {c.counts.cards.map((card) => (
            <div class="nx-tile lic-count nx-in">
              <h3 class="lic-name">{card.title}</h3>
              <div class="lic-count-part">
                <span class="lic-mark lic-mark-in">{c.counts.counted}</span>
                <p>{card.counted}</p>
              </div>
              <div class="lic-count-part">
                <span class="lic-mark">{c.counts.notCounted}</span>
                <p>{card.notCounted}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Full text and sales contact -->
    <section class="nx-section-tight nx-hairline lic-end">
      <div class="container-page">
        <div class="nx-cols" style="--cols:2">
          <div class="lic-end-col">
            <h2 class="nx-h3">{c.fullText.title}</h2>
            <p class="nx-body">{c.fullText.body}</p>
            <ul class="lic-links">
              {c.fullText.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class="nx-link">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
          <div class="lic-end-col">
            <h2 class="nx-h3">{c.contact.title}</h2>
            <p class="nx-body">{c.contact.body}</p>
            <a href={c.contact.href} class="nx-ghost lic-mail">{c.contact.label}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <NeonMotion />
</Base>

<style>
  .lic-hero {
    padding-bottom: 72px;
  }
  .lic-h1 {
    margin-top: 16px;
  }
  .lic-products {
    margin-top: 44px;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .lic-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .lic-product {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 26px 28px;
  }
  .lic-product .nx-body {
    margin: 0;
  }
  .lic-name {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }
  /* MIT in the mark's cyan, the Business Source License in amber */
  .lic-badge {
    align-self: flex-start;
    margin-bottom: 6px;
    border: 1px solid rgb(var(--a1) / 0.5);
    border-radius: 999px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    color: rgb(var(--a1));
    background: rgb(var(--a1) / 0.08);
  }
  .lic-badge-bsl {
    border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
    color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 10%, transparent);
  }

  .lic-h2 {
    margin-top: 14px;
  }
  .lic-terms {
    margin: 40px 0 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .lic-terms > div {
    display: grid;
    gap: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px 0;
  }
  @media (min-width: 768px) {
    .lic-terms > div {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 0 32px;
    }
  }
  .lic-terms dt {
    font-size: 16px;
    font-weight: 600;
    color: #fff;
  }
  .lic-terms dd {
    margin: 0;
    max-width: 760px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .lic-h3 {
    margin: 72px 0 0;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .lic-hint {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--color-dim);
  }
  .tier-scroll {
    margin-top: 24px;
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    background: linear-gradient(180deg, #141518, #0f1012);
  }
  .tier-scroll:focus-visible {
    outline: 2px solid rgb(var(--a1));
    outline-offset: 4px;
  }
  .tier-scroll table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    text-align: left;
    font-size: 15px;
  }
  .tier-scroll th,
  .tier-scroll td {
    padding: 16px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    white-space: nowrap;
  }
  .tier-scroll thead th {
    padding-block: 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-dim);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  .tier-scroll tbody tr:last-child > * {
    border-bottom: 0;
  }
  .tier-scroll tbody th {
    font-weight: 600;
    color: #fff;
  }
  .tier-scroll .num {
    font-family: var(--font-mono);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .tier-scroll .price {
    white-space: normal;
    color: var(--color-muted);
  }
  /* The free tier, set off in the mark's cyan */
  .tier-free > * {
    background: rgb(var(--a1) / 0.05);
  }
  .tier-free th {
    box-shadow: inset 2px 0 0 rgb(var(--a1));
  }
  .tier-free .price {
    color: rgb(var(--a1));
  }
  .lic-notes {
    margin-top: 20px;
    max-width: 920px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .lic-notes p {
    margin: 0;
  }

  .lic-counts {
    margin-top: 40px;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .lic-counts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .lic-count {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .lic-count-part {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lic-count-part p {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .lic-mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-dim);
  }
  .lic-mark::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 99px;
    border: 1px solid var(--color-dim);
  }
  .lic-mark-in {
    color: var(--color-text);
  }
  .lic-mark-in::before {
    border: 0;
    background: rgb(var(--a1));
    box-shadow: 0 0 8px rgb(var(--a1));
  }

  .lic-end {
    padding-bottom: 104px;
  }
  .lic-end-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .lic-links {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .lic-links .nx-link {
    font-size: 14.5px;
  }
  .lic-mail {
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
</style>
