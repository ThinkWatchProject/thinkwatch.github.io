---
// The /thinkwatch product page (self-hosted enterprise edition). A new hero,
// then the existing enterprise sections and a license teaser.
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import CompatibleWith from "~/components/sections/CompatibleWith.astro";
import Problem from "~/components/sections/Problem.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import FeaturesSection from "~/components/sections/FeaturesSection.astro";
import MCPAdvantage from "~/components/sections/MCPAdvantage.astro";
import LivePanels from "~/components/sections/LivePanels.astro";
import QuickStart from "~/components/sections/QuickStart.astro";
import LogExplorerMock from "~/components/mocks/LogExplorerMock.tsx";
import NeonMotion from "~/components/NeonMotion.astro";
import { getLang, localePath } from "~/i18n";
import { getLatestRelease } from "~/lib/github";
import { enterpriseLd } from "~/lib/structured-data";
import { thinkwatchCopy } from "~/i18n/pages/thinkwatch";

const lang = getLang(Astro);
const c = thinkwatchCopy[lang];
const zh = lang === "zh-CN";

const release = await getLatestRelease();
const version = release ? (release.startsWith("v") ? release : `v${release}`) : null;

const pills: { label: string; title?: string }[] = [
  ...c.hero.pills.map((label) => ({ label })),
  ...(version ? [{ label: version, title: c.hero.versionLabel }] : []),
  { label: c.hero.license },
];

const jsonLd = await enterpriseLd(lang);

const delay = (i: number) => `animation-delay: ${i * 90}ms;`;
---

<Base title={c.meta.title} description={c.meta.description} ogCard="enterprise" jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="nx-hero">
      <div class="nx-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="nx-gridbg" aria-hidden="true"></div>
      <div class="container-page grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14">
        <div class="min-w-0">
          {version && (
            <a class="nx-announce nx-rise" style="--d:0" href={localePath(lang, "/changelog")}><span class="dot"></span>{c.hero.announce(version.replace(/^v/, ""))}<span class="chev">→</span></a>
          )}
          <h1 class="nx-h1 nx-rise" style="--d:1">
            {c.hero.titleA}<span class:list={["nx-grad", zh && "whitespace-nowrap"]}>{c.hero.titleHighlight}</span>
          </h1>
          <p class="nx-lede nx-rise" style="--d:2">{c.hero.sub}</p>
          <div class="nx-actions nx-rise" style="--d:3">
            <a href="#quickstart" class="nx-pill">{c.hero.ctaPrimary}</a>
            <a href={localePath(lang, "/docs")} class="nx-ghost">{c.hero.ctaSecondary}</a>
          </div>
          <ul class="hero-pills nx-rise" style="--d:4">
            {pills.map((p) => (
              <li title={p.title}>{p.label}</li>
            ))}
          </ul>
        </div>

        <figure class="nx-panel hero-log nx-rise m-0" style="--d:3">
          <div class="log-host" aria-label={`${c.hero.mockTitle} · ${c.hero.mockSample}`}>
            <LogExplorerMock client:visible />
          </div>
          <figcaption class="log-note"><span class="text-[var(--color-accent)]">{c.hero.mockSample}</span> · {c.hero.mockNote}</figcaption>
        </figure>
      </div>
    </section>

    <CompatibleWith />
    <Problem />
    <HowItWorks />
    <FeaturesSection />
    <MCPAdvantage />
    <LivePanels />
    <QuickStart />

    <section class="py-14 sm:py-20" aria-labelledby="tw-license-teaser">
      <div class="container-page">
        <div class="flex flex-col gap-5 rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface)]/40 p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-10 lg:py-9">
          <div class="flex flex-col gap-2">
            <h2 id="tw-license-teaser" class="m-0 text-xl font-semibold tracking-tight sm:text-[22px]">
              {c.licenseTeaser.title}
            </h2>
            <p class="m-0 max-w-3xl text-base leading-normal text-[var(--color-muted)] sm:text-[17px]">
              {c.licenseTeaser.body}
            </p>
          </div>
          <a
            href={localePath(lang, "/license")}
            class="inline-flex min-h-11 shrink-0 items-center text-[17px] font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]"
          >
            {c.licenseTeaser.link}
            <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <NeonMotion />
</Base>

<style>
  .hero-pills {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .hero-pills li {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 3px 12px;
    font-size: 12px;
    color: #c3c7ce;
  }
  .log-host {
    height: 440px;
    overflow: hidden;
  }
  /* The mock brings its own card; inside the window it only needs its content */
  .log-host :global(> div) {
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
  }
  .log-note {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 16px;
    font-size: 12px;
    color: var(--color-dim);
  }
</style>
