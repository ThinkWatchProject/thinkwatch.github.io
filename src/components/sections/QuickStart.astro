---
import { codeToHtml } from "shiki";
import CodeTabs, { type Snippet } from "./CodeTabs.tsx";
import { getLang, localePath, t } from "~/i18n";

const lang = getLang(Astro);
const s = t(lang).quickstart;

// Client snippets. Env var names and the Cursor settings path follow the
// configuration guide built into the ThinkWatch console (/gateway/guide).
const rawSnippets: { id: string; label: string; lang: string; code: string }[] = [
  {
    id: "curl",
    label: "cURL",
    lang: "bash",
    code: `curl https://gateway.your-org.com/v1/chat/completions \\
  -H "Authorization: Bearer tw-your-api-key-here" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "gpt-4o",
    "messages": [{"role": "user", "content": "Hello"}],
    "stream": true
  }'`,
  },
  {
    id: "openai",
    label: "OpenAI SDK",
    lang: "python",
    code: `from openai import OpenAI

client = OpenAI(
    base_url="https://gateway.your-org.com/v1",
    api_key="tw-your-api-key-here",
)

stream = client.chat.completions.create(
    model="gpt-4o",
    messages=[{"role": "user", "content": "Hello"}],
    stream=True,
)
for chunk in stream:
    print(chunk.choices[0].delta.content or "", end="")`,
  },
  {
    id: "anthropic",
    label: "Anthropic SDK",
    lang: "python",
    code: `from anthropic import Anthropic

client = Anthropic(
    base_url="https://gateway.your-org.com",
    api_key="tw-your-api-key-here",
)

with client.messages.stream(
    model="claude-sonnet-4-5",
    max_tokens=1024,
    messages=[{"role": "user", "content": "Hello"}],
) as stream:
    for text in stream.text_stream:
        print(text, end="")`,
  },
  {
    id: "claude-code",
    label: "Claude Code",
    lang: "bash",
    code: `# Set ThinkWatch as the Anthropic API proxy
export ANTHROPIC_BASE_URL=https://gateway.your-org.com
export ANTHROPIC_API_KEY=tw-your-api-key-here

# Then use claude normally
claude`,
  },
  {
    id: "cursor",
    label: "Cursor",
    lang: "text",
    code: `// In Cursor Settings > Models > OpenAI API Key
// Base URL: https://gateway.your-org.com/v1
// API Key:  tw-your-api-key-here`,
  },
];

const snippets: Snippet[] = await Promise.all(
  rawSnippets.map(async (s) => ({
    id: s.id,
    label: s.label,
    raw: s.code,
    html: await codeToHtml(s.code, {
      lang: s.lang,
      theme: "github-dark-default",
    }),
  })),
);

// Commands match the Quick Start in the ThinkWatch README exactly.
const stepCmds: { cmds: string[]; url?: string }[] = [
  { cmds: ["make infra"] },
  { cmds: ["make dev-secrets", "make dev-backend"] },
  { cmds: ["cd web && pnpm install && pnpm dev"] },
  { cmds: [], url: "http://localhost:5173/setup" },
];
const steps = s.steps.map((step, i) => ({
  n: String(i + 1),
  title: step.title,
  body: step.body,
  ...stepCmds[i],
}));
---

<section id="quickstart" class="py-20 sm:py-28 border-t border-white/5 relative scroll-mt-20">
  <div class="container-page relative z-10">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-brand-1)] font-medium mb-4">
        {s.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">
        {s.title}<span class="text-gradient">{s.titleHighlight}</span>{s.titleEnd}
      </h2>
      <p class="mt-4 sm:mt-5 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">
        {s.sub}
      </p>
      <a
        href={localePath(lang, "/docs/deployment-guide")}
        class="mt-3 inline-flex min-h-11 items-center text-base font-medium text-[var(--color-brand-1)] hover:text-[var(--color-brand-2)] transition-colors"
      >
        {s.deployLink}
        <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="mt-10 sm:mt-14 grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-10 items-start">
      <ol class="space-y-4">
        {steps.map((step) => (
          <li class="rounded-xl border border-white/10 bg-[var(--color-surface)]/60 p-4 sm:p-5 flex gap-4 sm:gap-5">
            <div class="shrink-0 w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-brand-gradient text-black font-mono text-sm font-bold grid place-items-center" aria-hidden="true">
              {step.n}
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-semibold tracking-tight mb-1">{step.title}</div>
              <p class="text-sm text-[var(--color-muted)] mb-3">{step.body}</p>
              {step.cmds.length > 0 && (
                <code class="block font-mono text-[11px] sm:text-xs text-[var(--color-brand-1)] bg-black/40 border border-white/10 rounded-md px-3 py-2 overflow-x-auto whitespace-nowrap">
                  {step.cmds.map((cmd) => (
                    <span class="block"><span class="select-none text-[var(--color-dim)]">$ </span>{cmd}</span>
                  ))}
                </code>
              )}
              {step.url && (
                <code class="block font-mono text-[11px] sm:text-xs text-[var(--color-brand-1)] bg-black/40 border border-white/10 rounded-md px-3 py-2 overflow-x-auto whitespace-nowrap">
                  {step.url}
                </code>
              )}
            </div>
          </li>
        ))}
      </ol>

      <div class="lg:sticky lg:top-24">
        <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] mb-3">
          {s.pointAt}
        </div>
        <CodeTabs client:visible snippets={snippets} />
        <p class="mt-4 text-xs text-[var(--color-dim)]">
          {s.footer}<code class="font-mono text-[var(--color-brand-1)]">tw-</code>{s.footerSuffix}
        </p>
      </div>
    </div>
  </div>
</section>
