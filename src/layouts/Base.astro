---
import "~/styles/global.css";
import { getLang, t } from "~/i18n";
import Seo from "~/components/Seo.astro";
import Fonts from "~/components/Fonts.astro";
import { ogImageAlt, ogImagePath, type OgCard } from "~/lib/og";
import type { JsonLd } from "~/lib/structured-data";

const lang = getLang(Astro);
const i18n = t(lang);

interface Props {
  title: string;
  description: string;
  /** The Open Graph card shared for this page (see src/lib/og.ts); the site card by default */
  ogCard?: OgCard;
  /** "article" for documentation pages */
  ogType?: "website" | "article";
  /** For articles: first published and last changed, as ISO timestamps */
  published?: string;
  modified?: string;
  /** Keep the page out of search results (the 404 page) */
  noindex?: boolean;
  /** JSON-LD items describing the page (a product, an article, breadcrumbs). The Organization is added on every page. */
  jsonLd?: JsonLd[];
}

const {
  title,
  description,
  ogCard = "home",
  ogType = "website",
  published,
  modified,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site).toString();

const GA_ID = "G-R8LX8NCHCJ";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <Fonts />

    <!--
      Auto-redirect to the user's preferred locale.
      Runs synchronously before paint so there's no flash.
      Manual choice (set by the language dropdown) always wins.
    -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          var isZh = path === "/zh-CN" || path.indexOf("/zh-CN/") === 0;
          var stored = localStorage.getItem("tw-lang-pref");
          var want;
          if (stored === "en" || stored === "zh-CN") {
            want = stored;
          } else {
            var l = (navigator.language || "en").toLowerCase();
            want = l.indexOf("zh") === 0 ? "zh-CN" : "en";
          }
          if (want === "zh-CN" && !isZh) {
            location.replace("/zh-CN" + (path === "/" ? "" : path) + location.search + location.hash);
          } else if (want === "en" && isZh) {
            var stripped = path.replace(/^\/zh-CN/, "") || "/";
            location.replace(stripped + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>

    <Seo
      title={title}
      description={description}
      canonical={canonical}
      lang={lang}
      ogImage={ogImagePath(ogCard)}
      ogImageAlt={ogImageAlt(ogCard, lang)}
      ogType={ogType}
      published={published}
      modified={modified}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <!--
      Google Analytics (gtag). Honors Do Not Track and loads async so it
      never blocks first paint. No personal data is sent until the library
      has loaded.
    -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      (function () {
        try {
          if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;
        } catch (e) {}
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag("js", new Date());
        gtag("config", GA_ID, { anonymize_ip: true });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-brand-gradient focus:text-black focus:font-medium focus:shadow-xl"
    >
      {i18n.common.skipToContent}
    </a>
    <slot />
  </body>
</html>
