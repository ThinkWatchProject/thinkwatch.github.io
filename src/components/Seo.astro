---
import type { Lang } from "~/i18n";
import { OG_HEIGHT, OG_WIDTH } from "~/lib/og";
import { organization, type JsonLd } from "~/lib/structured-data";

interface Props {
  title: string;
  description: string;
  /** Left out on pages kept out of search results */
  canonical?: string;
  lang: Lang;
  /** Site-relative path of the Open Graph image, and its description */
  ogImage: string;
  ogImageAlt: string;
  ogType: "website" | "article";
  /** For articles: first published and last changed, as ISO timestamps */
  published?: string;
  modified?: string;
  /** Keep the page out of search results (the 404 page) */
  noindex?: boolean;
  /** The page's own JSON-LD items; the Organization is added on every page */
  jsonLd?: JsonLd[];
}

const {
  title,
  description,
  canonical,
  lang,
  ogImage,
  ogImageAlt,
  ogType,
  published,
  modified,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Build the cross-locale alternate URLs from the canonical path.
// Example: canonical = "https://thinkwat.ch/docs/architecture/"
//          → enHref   = "https://thinkwat.ch/docs/architecture/"
//          → zhHref   = "https://thinkwat.ch/zh-CN/docs/architecture/"
const rawPath = canonical ? new URL(canonical).pathname.replace(/^\/zh-CN/, "") || "/" : undefined;
const enHref = rawPath && new URL(rawPath, Astro.site).toString();
const zhHref = rawPath && new URL(`/zh-CN${rawPath === "/" ? "/" : rawPath}`, Astro.site).toString();

const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const ogLocale = lang === "zh-CN" ? "zh_CN" : "en_US";
const ogLocaleAlternate = lang === "zh-CN" ? "en_US" : "zh_CN";
const robots = noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1";

// `<` is escaped so that no string can close the script element early.
const allJsonLd = [organization, ...jsonLd].map((item) => JSON.stringify(item).replace(/</g, "\\u003c"));
---

<title>{title}</title>
<meta name="description" content={description} />
{/* The canonical URL and its hreflang alternates */}
{canonical && (
  <Fragment>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
  </Fragment>
)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="alternate" type="application/rss+xml" title="ThinkWatch release notes" href="/changelog.xml" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="ThinkWatch" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={ogImageAlt} />
{ogType === "article" && published && <meta property="article:published_time" content={published} />}
{ogType === "article" && modified && <meta property="article:modified_time" content={modified} />}

<!-- Twitter / X. There is no ThinkWatch account there, so no twitter:site. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Robots -->
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

<meta name="theme-color" content="#0b1220" />

{allJsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}
