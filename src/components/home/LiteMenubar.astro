---
// A code-drawn ThinkWatch Lite menu-bar dropdown. It illustrates what Lite
// shows; every value is sample data and is labelled as such.
import { getLang } from "~/i18n";

const zh = getLang(Astro) === "zh-CN";
const c = zh
  ? {
      aria: "ThinkWatch Lite 菜单栏示意，示例数据",
      today: "今日",
      sample: "示例数据",
      measured: "实测",
      estimated: "估算",
      unpriced: "未计价",
      requests: "次请求",
      notAdded: "三者不相加 · 价目表日期 [日期]",
      r1: "规则 [long-context] · 2 跳 · 流式返回",
      r2: "规则 [default] · 1 跳 · 脱敏 1 个密钥",
      r3t: "工具调用已标记",
      r3: "[shell 命令] · 在流中切断",
    }
  : {
      aria: "ThinkWatch Lite menu-bar illustration with sample data",
      today: "Today",
      sample: "Sample data",
      measured: "Measured",
      estimated: "Estimated",
      unpriced: "Unpriced",
      requests: "req",
      notAdded: "Not added together · prices as of [date]",
      r1: "rule [long-context] · 2 hops · streamed",
      r2: "rule [default] · 1 hop · 1 secret redacted",
      r3t: "Tool call flagged",
      r3: "[shell command] · cut off mid-stream",
    };
---

<div class="lite-menubar relative h-[420px] sm:h-[480px] overflow-hidden rounded-[18px] border border-[var(--color-border)]" role="img" aria-label={c.aria}>
  <div class="flex h-[30px] items-center justify-end gap-4 bg-[rgba(8,12,22,0.7)] px-4 text-[13px] text-[var(--color-muted)] backdrop-blur-md">
    <span class="flex items-center gap-1.5 rounded-[5px] bg-[rgba(61,219,217,0.16)] px-2 py-0.5 text-white">
      <svg width="14" height="14" viewBox="32 32 136 136" fill="none" aria-hidden="true"><rect x="32" y="32" width="136" height="136" rx="28" stroke="#3DDBD9" stroke-width="14"></rect><line x1="62" y1="68" x2="138" y2="68" stroke="#3DDBD9" stroke-width="16" stroke-linecap="round"></line><line x1="100" y1="68" x2="100" y2="104" stroke="#3DDBD9" stroke-width="16" stroke-linecap="round"></line><polyline points="62,104 80,140 100,104" stroke="#3DDBD9" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"></polyline><polyline points="100,104 120,140 138,104" stroke="#3DDBD9" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
      <span class="font-mono">$3.84</span>
    </span>
    <span class="h-2.5 w-4 rounded-[2px] border border-[var(--color-muted)]" aria-hidden="true"></span>
    <span class="font-mono">[time]</span>
  </div>

  <div class="absolute left-4 right-4 top-10 sm:left-auto sm:right-10 sm:w-[360px] overflow-hidden rounded-[14px] border border-[var(--color-border-strong)] bg-[rgba(17,26,46,0.92)] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.7)] backdrop-blur-lg">
    <div class="flex items-center justify-between border-b border-[#22304f] px-4 py-3.5">
      <span class="text-sm font-semibold text-white">{c.today}</span>
      <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-accent)]">{c.sample}</span>
    </div>
    <div class="grid grid-cols-3 gap-2 px-4 py-3.5">
      <div class="flex flex-col gap-1"><span class="text-[11px] text-[var(--color-muted)]">{c.measured}</span><span class="font-mono text-[17px] font-semibold text-[var(--color-brand-1)]">$3.12</span></div>
      <div class="flex flex-col gap-1"><span class="text-[11px] text-[var(--color-muted)]">{c.estimated}</span><span class="font-mono text-[17px] font-semibold text-white">$0.72</span></div>
      <div class="flex flex-col gap-1"><span class="text-[11px] text-[var(--color-muted)]">{c.unpriced}</span><span class="font-mono text-[17px] font-semibold text-[var(--color-accent)]">14 {c.requests}</span></div>
    </div>
    <div class="px-4 pb-3 font-mono text-[11px] text-[var(--color-muted)]">{c.notAdded}</div>
    <div class="flex flex-col border-t border-[#22304f]">
      <div class="lite-row flex flex-col gap-1 border-b border-[#1a2540] px-4 py-3" style="animation-delay: 0s;"><span class="font-mono text-xs text-white">claude-sonnet-4-5</span><span class="text-xs text-[var(--color-muted)]">{c.r1}</span></div>
      <div class="lite-row flex flex-col gap-1 border-b border-[#1a2540] px-4 py-3" style="animation-delay: 0.6s;"><span class="font-mono text-xs text-white">gpt-4o-mini</span><span class="text-xs text-[var(--color-muted)]">{c.r2}</span></div>
      <div class="lite-row flex flex-col gap-1 bg-[rgba(229,192,123,0.08)] px-4 py-3" style="animation-delay: 1.2s;"><span class="font-mono text-xs text-[var(--color-accent)]">{c.r3t}</span><span class="text-xs text-[var(--color-muted)]">{c.r3}</span></div>
    </div>
  </div>
</div>

<style>
  .lite-menubar {
    background:
      radial-gradient(ellipse at 70% 0%, rgba(61, 219, 217, 0.18), transparent 55%),
      radial-gradient(ellipse at 10% 100%, rgba(42, 58, 99, 0.9), transparent 60%),
      #0d1526;
  }
  .lite-row {
    opacity: 0;
    animation: lite-row 6s ease-out infinite;
  }
  @keyframes lite-row {
    0% { opacity: 0; transform: translateY(-6px); }
    8% { opacity: 1; transform: none; }
    90% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lite-row { opacity: 1; animation: none; }
  }
</style>
