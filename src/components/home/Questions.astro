---
// Visibility into every request: three things the gateway records, in hairline
// columns with line art, and a sample trace that plays row by row.
import { getLang } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";

const lang = getLang(Astro);
const c = homeCopy[lang].questions;
const t = homeCopy[lang].trace;
const rows: { k: string; v: string; tone?: "warn" | "ok" | "flag" }[] = [
  { k: t.client[0], v: t.client[1] },
  { k: t.rule[0], v: t.rule[1] },
  { k: t.hop1[0], v: `${t.hop1[1]} · ${t.hop1[2]} · ${t.hop1[3]}`, tone: "warn" },
  { k: t.hop2[0], v: `${t.hop2[1]} · ${t.hop2[2]} · ${t.hop2[3]}`, tone: "ok" },
  { k: t.cost[0], v: t.cost[1] },
  { k: t.redaction[0], v: t.redaction[1] },
  { k: t.tool[0], v: t.tool[1], tone: "flag" },
];
---

<section class="nx-section">
  <div class="container-page">
    <h2 class="nx-h2 nx-in">{c.eyebrow}</h2>
    <div class="nx-cols mt-14">
      {c.items.map((item, i) => (
        <article class="nx-in">
          <p class="nx-fig">{item.tag}</p>
          <svg viewBox="0 0 200 110" class="art" aria-hidden="true">
            {i === 0 && (
              <g>
                <path d="M20 55 H70 M130 30 H180 M130 80 H180" class="ink" />
                <path d="M70 55 C100 55 100 30 130 30 M70 55 C100 55 100 80 130 80" class="ink hot" />
                <circle cx="70" cy="55" r="5" class="ink hot" />
              </g>
            )}
            {i === 1 && (
              <g>
                <path d="M30 90 H170" class="ink" style="opacity:.4" />
                <path d="M45 90 V62 M70 90 V48 M95 90 V70 M120 90 V34 M145 90 V56" class="ink" />
                <circle cx="120" cy="34" r="4" class="ink hot" />
              </g>
            )}
            {i === 2 && (
              <g>
                <path d="M100 12 L140 26 V56 C140 78 122 92 100 100 C78 92 60 78 60 56 V26 Z" class="ink hot" />
                <path d="M84 58 L96 70 L118 46" class="ink" />
              </g>
            )}
          </svg>
          <h3 class="nx-h3">{item.title}</h3>
          <p class="nx-body">{item.body}</p>
        </article>
      ))}
    </div>

    <div class="nx-panel trace nx-in">
      <div class="nx-panel-top">
        <span class="nx-lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="flex-1 font-mono"><span class="text-[var(--color-brand-1)]">POST</span> /v1/messages</span>
        <span class="text-[var(--color-accent)]">{t.tag}</span>
      </div>
      <ol class="trace-rows">
        {rows.map((r, i) => (
          <li class:list={["trace-row", r.tone]} style={`animation-delay:${0.2 + i * 0.6}s`}>
            <span class="k">{r.k}</span><span class="v">{r.v}</span>
          </li>
        ))}
      </ol>
      <p class="trace-note">{t.note}</p>
    </div>
  </div>
</section>

<style>
  .art {
    display: block;
    width: 100%;
    max-width: 220px;
    margin: 16px 0 22px;
    overflow: visible;
  }
  .ink {
    fill: none;
    stroke: #5b6068;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .ink.hot {
    stroke: rgb(var(--a1));
    filter: drop-shadow(0 0 6px rgb(var(--a1) / 0.5));
  }
  .trace {
    margin-top: 56px;
  }
  .trace-rows {
    margin: 0;
    padding: 16px 20px;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .trace-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    border-radius: 6px;
    padding: 6px 8px;
    opacity: 0;
    animation: trace-row 10s ease-out infinite;
  }
  .k {
    color: var(--color-dim);
  }
  .v {
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .warn .v {
    color: var(--color-accent);
  }
  .ok .v {
    color: rgb(var(--a1));
  }
  .flag {
    animation: trace-row 10s ease-out infinite, trace-flash 10s ease-out infinite;
  }
  .flag .v {
    color: #ff8a8a;
  }
  .trace-note {
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 20px;
    font-size: 12px;
    color: var(--color-dim);
  }
  @keyframes trace-row {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    5% {
      opacity: 1;
      transform: none;
    }
    88% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes trace-flash {
    0%,
    62% {
      background: transparent;
    }
    64% {
      background: rgba(255, 107, 107, 0.2);
    }
    72%,
    100% {
      background: rgba(255, 107, 107, 0.06);
    }
  }
  @media (max-width: 640px) {
    .trace-row {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trace-row,
    .flag {
      opacity: 1;
      animation: none;
    }
  }
</style>
