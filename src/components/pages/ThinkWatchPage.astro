---
// The /thinkwatch product page (self-hosted enterprise edition). A new hero,
// then the existing enterprise sections, a license teaser, and star history.
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import CompatibleWith from "~/components/sections/CompatibleWith.astro";
import Problem from "~/components/sections/Problem.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import FeaturesSection from "~/components/sections/FeaturesSection.astro";
import MCPAdvantage from "~/components/sections/MCPAdvantage.astro";
import LivePanels from "~/components/sections/LivePanels.astro";
import QuickStart from "~/components/sections/QuickStart.astro";
import StarHistory from "~/components/sections/StarHistory.astro";
import LogExplorerMock from "~/components/mocks/LogExplorerMock.tsx";
import { getLang, localePath } from "~/i18n";
import { getLatestRelease } from "~/lib/github";
import { thinkwatchCopy } from "~/i18n/pages/thinkwatch";

const lang = getLang(Astro);
const c = thinkwatchCopy[lang];
const zh = lang === "zh-CN";

const release = await getLatestRelease();
const version = release ? (release.startsWith("v") ? release : `v${release}`) : null;

const pills: { label: string; title?: string }[] = [
  ...c.hero.pills.map((label) => ({ label })),
  ...(version ? [{ label: version, title: c.hero.versionLabel }] : []),
  { label: c.hero.license },
];

const delay = (i: number) => `animation-delay: ${i * 90}ms;`;
---

<Base title={c.meta.title} description={c.meta.description}>
  <SiteHeader />
  <main id="main">
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(50% 60% at 85% 20%, rgba(61, 219, 217, 0.09), transparent 65%);"
      ></div>
      <div class="container-page relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-[88px]">
        <div class="flex min-w-0 flex-col gap-5 sm:gap-6">
          <p class="reveal font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-brand-1)] sm:text-[13px]" style={delay(0)}>
            {c.hero.eyebrow}
          </p>
          <h1
            class:list={[
              "reveal font-display m-0 text-[var(--color-text)]",
              zh
                ? "text-[38px] leading-[1.25] sm:text-5xl lg:text-[64px]"
                : "text-[46px] leading-[1.02] sm:text-6xl lg:text-[80px] lg:leading-[0.98]",
            ]}
            style={delay(1)}
          >
            {c.hero.titleA}<span class="text-shimmer">{c.hero.titleHighlight}</span>
          </h1>
          <p class="reveal m-0 max-w-[36rem] text-[17px] leading-relaxed text-[#cbd5e1] sm:text-xl sm:leading-normal" style={delay(2)}>
            {c.hero.sub}
          </p>
          <div class="reveal mt-1 flex flex-col gap-3 sm:mt-2 sm:flex-row sm:items-center sm:gap-5" style={delay(3)}>
            <a
              href="#quickstart"
              class="inline-flex min-h-11 items-center justify-center rounded-[10px] bg-[var(--color-brand-1)] px-[22px] py-3 text-base font-semibold text-[var(--color-bg)] transition-colors hover:bg-[var(--color-brand-2)]"
            >
              {c.hero.ctaPrimary}
            </a>
            <a
              href={localePath(lang, "/docs")}
              class="inline-flex min-h-11 items-center justify-center text-base font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)] sm:justify-start"
            >
              {c.hero.ctaSecondary}
            </a>
          </div>
          <ul class="reveal m-0 mt-1 flex list-none flex-wrap gap-2.5 p-0 sm:mt-2 sm:gap-3" style={delay(4)}>
            {pills.map((p) => (
              <li
                class="rounded-full border border-[var(--color-border-strong)] px-3 py-1.5 text-[13px] text-[#cbd5e1]"
                title={p.title}
              >
                {p.label}
              </li>
            ))}
          </ul>
        </div>

        <figure class="reveal m-0 min-w-0" style={delay(3)}>
          <figcaption class="mb-3 flex items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.08em]">
            <span class="text-[var(--color-muted)]">{c.hero.mockTitle}</span>
            <span class="text-[var(--color-accent)]">{c.hero.mockSample}</span>
          </figcaption>
          <div class="h-[420px] overflow-hidden rounded-2xl sm:h-[500px]">
            <LogExplorerMock client:visible />
          </div>
          <p class="mt-3 text-xs text-[var(--color-dim)]">{c.hero.mockNote}</p>
        </figure>
      </div>
    </section>

    <CompatibleWith />
    <Problem />
    <HowItWorks />
    <FeaturesSection />
    <MCPAdvantage />
    <LivePanels />
    <QuickStart />

    <section class="py-14 sm:py-20" aria-labelledby="tw-license-teaser">
      <div class="container-page">
        <div class="flex flex-col gap-5 rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface)]/40 p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-10 lg:py-9">
          <div class="flex flex-col gap-2">
            <h2 id="tw-license-teaser" class="m-0 text-xl font-semibold tracking-tight sm:text-[22px]">
              {c.licenseTeaser.title}
            </h2>
            <p class="m-0 max-w-3xl text-base leading-normal text-[var(--color-muted)] sm:text-[17px]">
              {c.licenseTeaser.body}
            </p>
          </div>
          <a
            href={localePath(lang, "/license")}
            class="inline-flex min-h-11 shrink-0 items-center text-[17px] font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]"
          >
            {c.licenseTeaser.link}
            <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <StarHistory />
  </main>
  <SiteFooter />
</Base>
