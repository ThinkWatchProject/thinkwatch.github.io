---
// The /lite product page: ThinkWatch Lite, the menu-bar app for individual
// developers. Status copy must stay in line with the Lite README.
import Base from "~/layouts/Base.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import LiteMenubar from "~/components/home/LiteMenubar.astro";
import { getLang, localePath } from "~/i18n";
import { liteCopy } from "~/i18n/pages/lite";

const lang = getLang(Astro);
const c = liteCopy[lang];
const zh = lang === "zh-CN";

const repo = "https://github.com/ThinkWatchProject/ThinkWatch-Lite";
const docsHref = localePath(lang, "/docs/lite");
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "ThinkWatch Lite",
    description: c.meta.description,
    codeRepository: repo,
    programmingLanguage: ["TypeScript", "Rust"],
    license: "https://opensource.org/licenses/MIT",
    url: pageUrl,
    author: {
      "@type": "Organization",
      name: "ThinkWatch Project",
      url: "https://github.com/ThinkWatchProject",
    },
  },
];

const delay = (i: number) => `animation-delay: ${i * 90}ms;`;
const eyebrow = "font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted)] sm:text-[13px]";
const h2 = zh
  ? "font-display m-0 text-[26px] leading-[1.35] sm:text-[32px] lg:text-[36px]"
  : "font-display m-0 text-[30px] leading-[1.15] sm:text-[36px] lg:text-[40px]";
const textLink =
  "inline-flex min-h-11 items-center text-[17px] font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)]";
const nodes = [c.built.lite, c.built.core, c.built.upstreams];
---

<Base title={c.meta.title} description={c.meta.description} noJsonLd jsonLd={jsonLd}>
  <SiteHeader />
  <main id="main">
    <section class="relative overflow-hidden">
      <div class="container-page grid items-center gap-12 pb-12 pt-14 sm:pb-16 sm:pt-20 lg:grid-cols-2 lg:gap-16 lg:pb-[72px] lg:pt-[88px]">
        <div class="flex min-w-0 flex-col gap-5 sm:gap-6">
          <p class="reveal m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-brand-1)] sm:text-[13px]" style={delay(0)}>
            {c.hero.eyebrow}
          </p>
          <h1
            class:list={[
              "reveal font-display m-0 text-[var(--color-text)]",
              zh
                ? "text-[30px] leading-[1.35] sm:text-[40px] lg:text-[48px]"
                : "text-[36px] leading-[1.1] sm:text-[46px] lg:text-[56px] lg:leading-[1.05]",
            ]}
            style={delay(1)}
          >
            {c.hero.titleA}<span class="text-shimmer">{c.hero.titleHighlight}</span>
          </h1>
          <p class="reveal m-0 max-w-[36rem] text-[17px] leading-relaxed text-[#cbd5e1] sm:text-xl sm:leading-normal" style={delay(2)}>
            {c.hero.sub}
          </p>
          <div class="reveal mt-1 flex flex-col gap-3 sm:mt-2 sm:flex-row sm:items-center sm:gap-5" style={delay(3)}>
            <a
              href="#source"
              class="inline-flex min-h-11 items-center justify-center rounded-[10px] bg-[var(--color-brand-1)] px-[22px] py-3 text-base font-semibold text-[var(--color-bg)] transition-colors hover:bg-[var(--color-brand-2)]"
            >
              {c.hero.ctaPrimary}
            </a>
            <a
              href={docsHref}
              class="inline-flex min-h-11 items-center justify-center text-base font-medium text-[var(--color-brand-1)] transition-colors hover:text-[var(--color-brand-2)] sm:justify-start"
            >
              {c.hero.ctaSecondary}
            </a>
          </div>
        </div>
        <div class="reveal min-w-0" style={delay(3)}>
          <LiteMenubar />
        </div>
      </div>
    </section>

    <div class="container-page">
      <div
        class="reveal flex flex-col items-start gap-3 rounded-[14px] border border-[var(--color-accent)] bg-[var(--color-surface)] px-5 py-5 sm:flex-row sm:items-center sm:gap-7 sm:px-7 sm:py-6"
        style={delay(5)}
      >
        <span class="shrink-0 rounded-full bg-[var(--color-accent)] px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.06em] text-[var(--color-bg)]">
          {c.status.badge}
        </span>
        <p class="m-0 text-base leading-relaxed text-[#cbd5e1] sm:text-[17px]">{c.status.body}</p>
      </div>
    </div>

    <section class="py-16 sm:py-20 lg:py-24" aria-labelledby="lite-shows">
      <div class="container-page">
        <h2 id="lite-shows" class:list={[eyebrow, "m-0 font-normal"]}>{c.shows.eyebrow}</h2>
        <div class="mt-8 grid gap-4 sm:gap-6 md:grid-cols-2">
          {c.shows.cards.map((card) => (
            <div class="flex flex-col gap-3 rounded-2xl border border-[var(--color-border-strong)] p-6 transition-colors hover:border-[var(--color-brand-1)]/50 sm:p-8">
              <h3 class="m-0 text-xl font-semibold leading-snug tracking-tight sm:text-2xl">{card.title}</h3>
              <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">{card.body}</p>
            </div>
          ))}
        </div>
        <div class="mt-4 flex flex-col items-start gap-4 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:mt-6 sm:flex-row sm:items-center sm:gap-7 sm:px-8 sm:py-7">
          <div class="flex shrink-0 items-center gap-2 rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-3.5 py-2 font-mono text-[15px] text-[var(--color-brand-1)]">
            <svg width="14" height="14" viewBox="32 32 136 136" fill="none" aria-hidden="true"><rect x="32" y="32" width="136" height="136" rx="28" stroke="currentColor" stroke-width="14"></rect><line x1="62" y1="68" x2="138" y2="68" stroke="currentColor" stroke-width="16" stroke-linecap="round"></line><line x1="100" y1="68" x2="100" y2="104" stroke="currentColor" stroke-width="16" stroke-linecap="round"></line><polyline points="62,104 80,140 100,104" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"></polyline><polyline points="100,104 120,140 138,104" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
            {c.shows.menubarChip}
          </div>
          <p class="m-0 text-base leading-relaxed text-[var(--color-muted)] sm:text-[17px]">
            <span class="font-semibold text-[var(--color-text)]">{c.shows.menubarLead}</span>
            {" "}{c.shows.menubarBody}
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-surface)] py-16 sm:py-20 lg:py-[88px]" aria-labelledby="lite-built">
      <div class="container-page">
        <h2 id="lite-built" class:list={[eyebrow, "m-0 font-normal"]}>{c.built.eyebrow}</h2>
        <div class="mt-8 grid items-stretch lg:mt-10 lg:grid-cols-[minmax(0,1fr)_120px_minmax(0,1fr)_120px_minmax(0,1fr)] lg:items-center">
          {nodes.map((node, i) => (
            <Fragment>
              {i > 0 && (
                <div
                  class="flow-link relative flex items-center justify-center py-2 lg:py-0"
                  data-active={i === 1 ? "true" : undefined}
                  aria-hidden={i === 1 ? undefined : "true"}
                >
                  <div
                    class:list={[
                      "flow-line relative h-10 w-px lg:h-px lg:w-full",
                      i === 1 ? "bg-[var(--color-brand-1)]" : "bg-[var(--color-border-strong)]",
                    ]}
                  >
                    {i === 1 && <span class="flow-dot" aria-hidden="true"></span>}
                  </div>
                  {i === 1 && (
                    <span class="absolute left-[calc(50%+14px)] font-mono text-xs text-[var(--color-muted)] lg:left-auto lg:top-[calc(50%+8px)]">
                      {c.built.link}
                    </span>
                  )}
                </div>
              )}
              <div
                class:list={[
                  "flex flex-col gap-2.5 rounded-[14px] border bg-[var(--color-bg)]/30 p-6 sm:p-7",
                  i === 0 ? "border-[var(--color-brand-1)]" : "border-[var(--color-border-strong)]",
                ]}
              >
                <h3 class="m-0 text-xl font-semibold sm:text-[22px]">{node.title}</h3>
                <p class="m-0 text-[15px] leading-normal text-[var(--color-muted)]">{node.body}</p>
              </div>
            </Fragment>
          ))}
        </div>
      </div>
    </section>

    <section id="source" class="scroll-mt-20 py-16 sm:py-20 lg:py-[88px]">
      <div class="container-page grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col gap-4">
          <p class:list={[eyebrow, "m-0"]}>{c.source.eyebrow}</p>
          <h2 class={h2}>{c.source.title}</h2>
          <a href={docsHref} class={textLink}>{c.source.link}</a>
        </div>
        <div class="overflow-x-auto rounded-[14px] border border-[var(--color-border-strong)] bg-[var(--color-surface)] p-5 font-mono text-[15px] leading-relaxed sm:p-7 sm:text-base">
          <code class="flex flex-col gap-2.5 whitespace-nowrap text-[#e6ebf2]">
            <span><span class="select-none text-[var(--color-dim)]">$ </span>pnpm install</span>
            <span><span class="select-none text-[var(--color-dim)]">$ </span>pnpm tauri dev</span>
          </code>
        </div>
      </div>
    </section>

    <section class="pb-16 sm:pb-20 lg:pb-[88px]">
      <div class="container-page">
        <div class="flex flex-col gap-4 rounded-2xl border border-[var(--color-border-strong)] p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-10">
          <div class="flex flex-col gap-1.5">
            <h2 class="m-0 text-xl font-semibold sm:text-[22px]">{c.license.title}</h2>
            <p class="m-0 text-base text-[var(--color-muted)] sm:text-[17px]">{c.license.body}</p>
          </div>
          <a href={repo} target="_blank" rel="noopener" class:list={[textLink, "shrink-0"]}>
            {c.license.link}
            <svg class="ml-1.5 h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  /* A small dot travels along the Lite-to-Core link to suggest traffic. */
  .flow-dot {
    position: absolute;
    left: -3px;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-brand-2);
    box-shadow: 0 0 10px rgba(61, 219, 217, 0.8);
    animation: flow-v 2.4s ease-in-out infinite;
  }
  @keyframes flow-v {
    0% { top: 0; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { top: calc(100% - 7px); opacity: 0; }
  }
  @media (min-width: 1024px) {
    .flow-dot {
      top: -3px;
      left: 0;
      animation-name: flow-h;
    }
    @keyframes flow-h {
      0% { left: 0; opacity: 0; }
      15% { opacity: 1; }
      85% { opacity: 1; }
      100% { left: calc(100% - 7px); opacity: 0; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-dot { display: none; }
  }
</style>
