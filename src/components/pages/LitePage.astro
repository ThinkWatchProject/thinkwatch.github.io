    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 16px;
    font-size: 12px;
    color: var(--color-muted);
  }
  .lights {
    display: inline-flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 99px;
    background: #2a2c31;
  }
  .flow-title {
    flex: 1;
    min-width: 0;
  }
  .scenes {
    display: inline-flex;
    gap: 5px;
  }
  .scenes i {
    width: 18px;
    height: 3px;
    border-radius: 3px;
    background: #2a2c31;
    transition: background 300ms;
  }
  .scenes i[data-on] {
    background: rgb(var(--a1));
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgb(var(--a1));
  }
  .live i {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: rgb(var(--a1));
    animation: blink 1.6s ease-in-out infinite;
  }
  .flow-grid {
    display: grid;
    grid-template-columns: 1fr 64px 1.3fr 64px 1fr;
    align-items: center;
    padding: 32px 28px 20px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .col-label {
    margin: 0 0 4px;
    font-size: 12px;
    color: var(--color-dim);
  }
  .node {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 13px;
    color: #62666d;
    background: rgba(255, 255, 255, 0.015);
    transition: color 300ms, border-color 300ms, background 300ms, box-shadow 300ms;
  }
  .node.on {
    color: var(--color-text);
    border-color: rgb(var(--a1) / 0.5);
    background: rgb(var(--a1) / 0.07);
    box-shadow: 0 0 24px -8px rgb(var(--a1) / 0.6);
  }
  .node.fail {
    color: var(--color-accent);
    border-color: rgba(229, 192, 123, 0.5);
    background: rgba(229, 192, 123, 0.07);
    text-decoration: line-through;
  }
  .wire {
    position: relative;
    height: 1px;
    background: linear-gradient(90deg, rgb(var(--a1) / 0.1), rgb(var(--a1) / 0.55), rgb(var(--a2) / 0.2));
  }
  .packet {
    position: absolute;
    top: -3px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: rgb(var(--a1));
    box-shadow: 0 0 12px rgb(var(--a1));
    opacity: 0;
  }
  .packet.p2 {
    background: rgb(var(--a2));
    box-shadow: 0 0 12px rgb(var(--a2));
  }
  .flow[data-running] .packet {
    animation: travel 1.1s ease-in-out infinite;
  }
  .flow[data-running] .packet.p2 {
    animation-delay: 0.45s;
  }
  .flow[data-running] .packet.late {
    animation-delay: 0.55s;
  }
  .flow[data-running] .packet.late.p2 {
    animation-delay: 1s;
  }
  .gw {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 16px;
    background: #141518;
    box-shadow: 0 0 60px -20px rgb(var(--a1) / 0.4);
  }
  .gw-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .checks {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #62666d;
    transition: color 300ms;
  }
  .checks li::before {
    content: "";
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: #2a2c31;
    transition: background 300ms, box-shadow 300ms;
  }
  .checks b {
    font-weight: 400;
  }
  .checks li span {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 300ms, transform 300ms;
  }
  .checks li[data-on] {
    color: var(--color-text);
  }
  .checks li[data-on]::before {
    background: rgb(var(--a1));
    box-shadow: 0 0 8px rgb(var(--a1));
  }
  .checks li[data-on] span {
    opacity: 1;
    transform: none;
    color: var(--color-muted);
  }
  .checks li.warn[data-on]::before {
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }
  .checks li.warn[data-on] span {
    color: var(--color-accent);
  }
  .checks li.bad[data-on]::before {
    background: #ff6b6b;
    box-shadow: 0 0 8px #ff6b6b;
  }
  .checks li.bad[data-on] span {
    color: #ff6b6b;
  }
  .log {
    margin: 0;
    padding: 14px 28px 22px;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 2;
    color: var(--color-muted);
    min-height: 152px;
  }
  .log li {
    display: block;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 350ms, transform 350ms;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .log li[data-on] {
    opacity: 1;
    transform: none;
  }
  .log :global(time) {
    display: inline-block;
    width: 72px;
    margin-right: 16px;
    color: #62666d;
  }
  .log.en :global(time) {
    width: 84px;
  }
  .log :global(b) {
    font-weight: 500;
    color: var(--color-text);
  }
  .log :global(code) {
    color: var(--color-accent);
  }
  .log :global(em.w) {
    font-style: normal;
    color: var(--color-accent);
  }
  .log :global(code.x) {
    color: #ff6b6b;
    text-decoration: line-through;
  }
  @media (max-width: 760px) {
    .flow-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 20px 16px 16px;
    }
    .wire {
      display: none;
    }
    .col {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .col-label {
      width: 100%;
    }
    .log {
      padding: 12px 16px 18px;
      font-size: 11.5px;
    }
    .log :global(time),
    .log.en :global(time) {
      width: 60px;
      margin-right: 10px;
    }
  }

  /* ---------- Status row ---------- */
  .status {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px 0;
  }
  .status-badge {
    align-self: flex-start;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(var(--a1)), rgb(var(--a2)));
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 600;
    color: #08090a;
  }
  .status-grid {
    margin: 0;
    display: grid;
    gap: 16px 32px;
  }
  @media (min-width: 640px) {
    .status-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .status {
      flex-direction: row;
      align-items: flex-start;
      gap: 32px;
    }
    .status-grid {
      flex: 1;
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Client wall ---------- */
  .wall {
    padding: 44px 0 20px;
  }
  .wall-label {
    margin: 0 0 18px;
    text-align: center;
    font-size: 13px;
    color: var(--color-dim);
  }
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    gap: 56px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: #9ca1a9;
    animation: marquee 38s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }

  /* ---------- Section heads ---------- */
  .h-sec {
    margin: 0;
    max-width: 820px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.14;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .dim {
    color: var(--color-muted);
  }

  /* ---------- Story ---------- */
  .story {
    padding: 104px 0 96px;
  }
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
  }
  .story-steps {
    position: relative;
  }
  .rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }
  .rail i {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(var(--a1)), rgb(var(--a2)));
    transform-origin: top;
    transform: scaleY(0);
    box-shadow: 0 0 10px rgb(var(--a1) / 0.6);
  }
  .step {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 28px;
    opacity: 0.32;
    transition: opacity 400ms;
  }
  .step[data-active] {
    opacity: 1;
  }
  .step-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-size: 13px;
    color: rgb(var(--a1));
  }
  .step-tag span {
    font-family: var(--font-mono);
    font-size: 11px;
    border: 1px solid rgb(var(--a1) / 0.4);
    border-radius: 6px;
    padding: 1px 6px;
  }
  .step h3 {
    margin: 0;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .step p:not(.step-tag) {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .step-shot {
    display: none;
  }
  /* No frame of its own: the screenshots already carry the macOS window and its
     shadow, so the screen only adds a soft brand glow behind them */
  .screen {
    position: sticky;
    top: calc(50vh - 240px);
    aspect-ratio: 2360 / 1540;
    max-width: 100%;
    transition: transform 300ms ease-out;
  }
  .screen::before {
    content: "";
    position: absolute;
    inset: 12% 8%;
    z-index: -1;
    border-radius: 40px;
    background: radial-gradient(closest-side, rgb(var(--a1) / 0.22), rgb(var(--a2) / 0.1) 60%, transparent);
    filter: blur(40px);
  }
  .screen img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.03);
    filter: blur(4px);
    transition: opacity 550ms, transform 800ms, filter 550ms;
  }
  .screen img[data-active] {
    opacity: 1;
    transform: none;
    filter: none;
  }
  @media (max-width: 1023px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-screen,
    .rail {
      display: none;
    }
    .step {
      min-height: 0;
      padding: 36px 0 0;
      opacity: 1;
    }
    .step-shot {
      display: block;
      width: 100%;
      margin-top: 20px;
      border-radius: 10px;
    }
  }

  /* ---------- Bento ---------- */
  .bento-sec {
    padding: 24px 0 104px;
  }
  .bento {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }
  .tile {
    --mx: -200px;
    --my: -200px;
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, #141518, #0f1012);
    padding: 28px;
    transition: border-color 200ms;
  }
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgb(var(--a1) / 0.1), transparent 60%);
    pointer-events: none;
  }
  .tile:hover {
    border-color: rgba(255, 255, 255, 0.14);
  }
  .tile h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .tile p {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .t-menubar {
    grid-column: span 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 32px;
    align-items: center;
    padding-bottom: 0;
    min-height: 340px;
  }
  .t-menubar .tile-text {
    padding-bottom: 28px;
  }
  /* the menu rises from the bottom edge of the tile */
  .menu-stage {
    align-self: end;
    height: 312px;
    overflow: hidden;
  }
  .chip-bar {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 6px 10px;
    background: rgba(255, 255, 255, 0.03);
  }
  .chip-nums {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.15;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .chip-nums b {
    font-weight: 500;
  }
  .menu-shot {
    display: block;
    width: 260px;
    border-radius: 12px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.14);
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .t-menubar:hover .menu-shot {
    transform: translateY(-10px);
  }
  .t-clients,
  .t-formats,
  .t-keys {
    grid-column: span 2;
  }
  .t-mcp {
    grid-column: span 4;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding: 0 28px 0 0;
  }
  .t-dry,
  .t-notices {
    grid-column: span 2;
  }
  .crop-wrap {
    position: relative;
    height: 100%;
    min-height: 240px;
    overflow: hidden;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .crop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 60px;
    background: linear-gradient(transparent, rgb(var(--a1) / 0.18), transparent);
    border-bottom: 1px solid rgb(var(--a1) / 0.6);
    animation: scan 3.6s ease-in-out infinite;
  }
  /* One picture height for the whole row, so the headings below line up */
  .vis {
    height: 168px;
    margin-bottom: 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .t-dry .vis {
    height: 196px;
    margin: -28px -28px 22px;
  }
  .dry-shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .big {
    margin: 0 !important;
    font-size: 48px !important;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05 !important;
    background: linear-gradient(90deg, rgb(var(--a1)), rgb(var(--a2)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
  }
  .big-sub {
    margin: 8px 0 22px !important;
    font-size: 13px !important;
    color: var(--color-dim) !important;
  }
  :global(.tick) {
    animation: tick 600ms ease-out;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .chips span {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 5px 11px;
    font-size: 12px;
    color: var(--color-muted);
    animation: chip 4s ease-in-out infinite;
  }
  .chips span:nth-child(2) {
    animation-delay: 1s;
  }
  .chips span:nth-child(3) {
    animation-delay: 2s;
  }
  .chips span:nth-child(4) {
    animation-delay: 3s;
  }
  /* The plugins tile: the whole last row, the copy beside a short plugin */
  .t-plugins {
    grid-column: span 6;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .perms span {
    font-family: var(--font-mono);
    animation-duration: 6s;
  }
  .perms span:nth-child(5) {
    animation-delay: 4s;
  }
  .perms span:nth-child(6) {
    animation-delay: 5s;
  }
  .code-win {
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: #0b0c0e;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  .code-top {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 9px 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-dim);
  }
  .code-win pre {
    margin: 0;
    padding: 14px 18px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: #c3c7ce;
  }
  .code-win :global(.k) {
    color: rgb(var(--a2));
  }
  .code-win :global(.s) {
    color: rgb(var(--a1));
  }
  .code-win :global(.n) {
    color: #8fb8ff;
  }
  /* the line that declares what the plugin may read and change */
  .code-win :global(.hl) {
    display: inline-block;
    min-width: calc(100% + 36px);
    margin: 0 -18px;
    padding: 0 18px;
    background: rgb(var(--a1) / 0.07);
    box-shadow: inset 2px 0 rgb(var(--a1) / 0.7);
  }
  .keyrows {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .keyrows li {
    display: flex;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 7px 0;
    color: var(--color-muted);
  }
  .keyrows b {
    flex: 1;
    font-weight: 500;
    color: var(--color-text);
  }
  .keyrows em {
    font-style: normal;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  /* Notifications stacked the way macOS groups them: the newest in front,
     older ones peeking out below and moving back as the next arrives */
  .notifs {
    --nh: 92px;
    position: relative;
    height: calc(var(--nh) + 24px);
    margin: 0;
    padding: 0;
    list-style: none;
    /* the next one waits above the top edge, out of sight */
    clip-path: inset(0 -40px -40px -40px);
  }
  .notif {
    position: absolute;
    inset: 0 0 auto;
    height: var(--nh);
    display: flex;
    gap: 10px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 10px 12px;
    background: #202227;
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.8);
    transform-origin: 50% 100%;
    animation: notif 9s ease-in-out infinite;
  }
  .notif:nth-child(1) {
    z-index: 3;
  }
  .notif:nth-child(2) {
    z-index: 2;
    transform: translateY(12px) scale(0.94);
    filter: brightness(0.7);
    animation-delay: -3s;
  }
  .notif:nth-child(3) {
    z-index: 1;
    transform: translateY(24px) scale(0.88);
    filter: brightness(0.45);
    animation-delay: -6s;
  }
  .notif-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: linear-gradient(180deg, #0d0f22, #020208);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .notif-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-size: 12.5px;
    line-height: 1.4;
  }
  .notif-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 11px;
    color: var(--color-dim);
  }
