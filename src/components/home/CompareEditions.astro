---
import { getLang, localePath } from "~/i18n";
import { homeCopy } from "~/i18n/pages/home";

const lang = getLang(Astro);
const c = homeCopy[lang].compare;
const editions = [
  { name: "ThinkWatch Lite", href: localePath(lang, "/lite"), v: c.lite },
  { name: lang === "zh-CN" ? "ThinkWatch 企业版" : "ThinkWatch Enterprise", href: localePath(lang, "/thinkwatch"), v: c.thinkwatch },
  { name: "ThinkWatch Core", href: localePath(lang, "/core"), v: c.core },
];
const rows = ["runsAs", "builtFor", "status", "license"] as const;
---

<section class="nx-section nx-hairline">
 <div class="container-page">
  <h2 class="nx-h2 nx-in">{c.eyebrow}</h2>

  <div class="mt-10 hidden grid-cols-[200px_repeat(3,minmax(0,1fr))] gap-x-8 text-base md:grid nx-in">
    <div class="border-b border-white/15 py-3.5"></div>
    {editions.map((e) => (
      <a href={e.href} class="border-b border-white/15 py-3.5 text-xl font-semibold text-white transition-colors hover:text-[var(--color-brand-1)]">{e.name}</a>
    ))}
    {rows.map((row) => (
      <>
        <div class="border-b border-white/[0.07] py-[18px] text-sm text-[var(--color-dim)]">{c.rows[row]}</div>
        {editions.map((e) => (
          <div class="border-b border-white/[0.07] py-[18px] leading-relaxed text-[#c3c7ce]">{e.v[row]}</div>
        ))}
      </>
    ))}
  </div>

  <div class="mt-7 flex flex-col gap-4 md:hidden">
    {editions.map((e) => (
      <a href={e.href} class="nx-tile flex flex-col gap-3 !p-5">
        <span class="text-lg font-semibold text-white">{e.name}</span>
        <dl class="grid grid-cols-[88px_minmax(0,1fr)] gap-x-3 gap-y-2 text-[15px]">
          {rows.map((row) => (
            <>
              <dt class="font-mono text-xs leading-6 text-[var(--color-muted)]">{c.rows[row]}</dt>
              <dd class="leading-relaxed text-[#c3c7ce]">{e.v[row]}</dd>
            </>
          ))}
        </dl>
      </a>
    ))}
  </div>

  <a href={localePath(lang, "/license")} class="nx-link mt-7">{c.link}</a>
 </div>
</section>
