---
// ThinkWatch guides: /docs/<slug>. Lite and Core live under their own folders.
import DocArticle from "~/pages/docs/_DocArticle.astro";
import { getArticlePaths } from "~/pages/docs/_lib";

export async function getStaticPaths() {
  return getArticlePaths("thinkwatch", "en");
}

const { entry, slug } = Astro.props;
---

<DocArticle lang="en" product="thinkwatch" slug={slug} entry={entry} />
